{
	"name": "@bedrock-core/ui",
	"version": "0.14.1",
	"description": "Customizable UI system for Minecraft Bedrock server forms cross-addon compatible.",
	"keywords": [
		"ui",
		"api",
		"minecraft",
		"bedrock",
		"typescript",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/ui",
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./navigation": {
			"types": "./src/navigation.ts",
			"import": "./src/navigation.ts"
		},
		"./ore-styled": {
			"types": "./src/ore-styled.ts",
			"import": "./src/ore-styled.ts"
		},
		"./flexbox": {
			"types": "./src/flexbox.ts",
			"import": "./src/flexbox.ts"
		},
		"./container": {
			"types": "./src/container.ts",
			"import": "./src/container.ts"
		},
		"./entity": {
			"types": "./src/entity.ts",
			"import": "./src/entity.ts"
		},
		"./eslint": {
			"types": "./eslint/index.d.ts",
			"import": "./eslint/index.mjs"
		},
		"./jsx-runtime": {
			"types": "./src/jsx/jsx-runtime.ts",
			"import": "./src/jsx/jsx-runtime.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./src/jsx/jsx-dev-runtime.ts",
			"import": "./src/jsx/jsx-dev-runtime.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"eslint",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"!{node_modules,dist,build,coverage,.cache,.bds,.bedrock-core}/**",
		"!**/{node_modules,dist,build,coverage,.cache,.bds,.bedrock-core}/**",
		"!.changeset/**",
		"!docs/**",
		"!packages/**"
	],
	"packageManager": "yarn@4.16.0",
	"workspaces": [
		".",
		"packages/ui-runtime",
		"packages/navigation",
		"packages/ore-styled",
		"packages/flexbox",
		"packages/ui-compiler"
	],
	"scripts": {
		"build": "yarn workspaces foreach -ptA run build",
		"build:libs": "yarn workspaces foreach -A -pt --no-private --exclude '@bedrock-core/ui' run build",
		"prepack": "yarn build:libs",
		"watch": "yarn --cwd packages/resource-pack watch",
		"typecheck": "yarn workspace @bedrock-core/navigation build:api && node node_modules/typescript-native/bin/tsc --noEmit",
		"lint": "yarn workspaces foreach -ptA run lint",
		"lint:libs": "yarn workspaces foreach -A -pt --no-private --exclude '@bedrock-core/ui' run lint",
		"test": "yarn workspaces foreach -ptA run test",
		"test:libs": "yarn workspaces foreach -A -pt --no-private --exclude '@bedrock-core/ui' run test",
		"test:lint": "node --test scripts/eslint/*.test.mjs",
		"test:release": "yarn test:lint && node node_modules/typescript-native/bin/tsc -p scripts/tsconfig.json && node --test scripts/*.test.mjs scripts/*.test.ts packages/ui-runtime/scripts/*.test.mjs",
		"coverage": "yarn workspaces foreach -ptA run coverage",
		"deploy": "yarn --cwd packages/resource-pack deploy",
		"preflight": "node scripts/preflight.mjs",
		"gamelog": "node scripts/gamelog.mjs",
		"changeset": "changeset",
		"version-packages": "changeset version && node scripts/sync-pack-version.mjs",
		"release": "yarn release:libraries",
		"release:libraries": "yarn test:release && yarn lint:libs && yarn build:libs && yarn test:libs && node scripts/publish-tarballs.mjs && changeset git-tag",
		"clean": "node scripts/clean.mjs"
	},
	"dependencies": {
		"@bedrock-core/flexbox": "workspace:*",
		"@bedrock-core/navigation": "workspace:*",
		"@bedrock-core/ore-styled": "workspace:*",
		"@bedrock-core/ui-compiler": "workspace:*",
		"@bedrock-core/ui-runtime": "workspace:*"
	},
	"devDependencies": {
		"@bedrock-core/server-runtime": "*",
		"@bedrock-core/sync": "*",
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "3.0.3",
		"@eslint/css": "^1.2.0",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@eslint/markdown": "^8.0.1",
		"@minecraft/common": "*",
		"@minecraft/server": "*",
		"@minecraft/server-ui": "*",
		"@minecraft/vanilla-data": "*",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "*",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"typescript-native": "npm:typescript@7.1.0-beta",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@bedrock-core/i18n": "*",
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0",
		"@minecraft/server-ui": "*",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "7.1.1"
	},
	"peerDependenciesMeta": {
		"@bedrock-core/i18n": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"eslint-plugin-react-hooks": {
			"optional": true
		}
	},
	"resolutions": {
		"@bedrock-core/db": "file:../server/packages/db",
		"@bedrock-core/i18n": "file:../server/packages/i18n",
		"@bedrock-core/observable": "file:../server/packages/observable",
		"@bedrock-core/server-runtime": "file:../server/packages/server-runtime",
		"@bedrock-core/sync": "file:../server/packages/sync",
		"@minecraft/common": "1.2.0",
		"@minecraft/server": "2.10.0",
		"@minecraft/server-ui": "2.2.0",
		"@minecraft/vanilla-data": "1.26.50",
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^1.2.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^25.6.2",
		"@vitest/coverage-v8": "^4.1.5",
		"eslint": "^10.3.0",
		"eslint-plugin-minecraft-linting": "^2.0.12",
		"opentype.js": "^1.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vitest": "^4.1.5"
	}
}
