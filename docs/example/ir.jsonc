{
  // The IR of Counter after analysis. Host-agnostic: no slot, no entry, no
  // collection appears here. Rects are the base solved at build (texels,
  // relative to the parent). Nothing is layout-live, so there are no islands.
  "screen": "counter",
  "canvas": { "width": 320, "height": 210 },
  "root": {
    "kind": "panel",
    "name": "panel_1",
    "rect": { "x": 0, "y": 0, "width": 54, "height": 50 },
    "look": { "shape": "nineslice", "texture": "textures/ui/dialog_background_opaque" },
    "children": [
      {
        "kind": "label",
        "name": "label_1",
        "rect": { "x": 6, "y": 6, "width": 42, "height": 10 },
        "look": { "shape": "label", "font": "default", "scale": 1 },
        // Never differed between probes: baked.
        "text": { "class": "baked", "value": "COUNTER" }
      },
      {
        "kind": "label",
        "name": "label_2",
        // Reserved at build: maxLength x the widest glyph. Not an island.
        "rect": { "x": 6, "y": 20, "width": 12, "height": 10 },
        "look": { "shape": "label", "font": "default", "scale": 1 },
        // Differed when `count` was probed; capacity declared by maxLength.
        "text": { "class": "carried", "type": "text", "capacity": { "kind": "text", "maxLength": 2 }, "initial": "0" }
      },
      {
        "kind": "button",
        "name": "button_1",
        "rect": { "x": 6, "y": 34, "width": 12, "height": 10 },
        "look": {
          "shape": "button_face",
          "default": "textures/ui/unstyled",
          "hover": "textures/ui/unstyled",
          "pressed": "textures/ui/unstyled",
          "locked": "textures/ui/unstyled"
        },
        // Flipped when `count` was probed past 9: a carried bool.
        "enabled": { "class": "carried", "type": "bool", "capacity": { "kind": "bool" }, "initial": true },
        // A handler is present: the host has to deliver a press.
        "inputs": [{ "kind": "press" }],
        "children": [
          {
            "kind": "label",
            "name": "label_3",
            "rect": { "x": 0, "y": 0, "width": 12, "height": 10 },
            "look": { "shape": "label", "font": "default", "scale": 1 },
            "text": { "class": "baked", "value": "+1" }
          }
        ]
      }
    ]
  }
}
