{
  // counter.chest.screen.tsx compiled for the chest host.
  //
  // Baked parts REFERENCE shapes with $var overrides. Live parts are LITERAL
  // definitions emitted here, one per binding shape, because a $var inside a
  // binding is dropped under the chest mount (modification-inserted subtree).
  // Every binding pattern below is the one that renders in game today; the
  // namespaces are the v2 names (core_ui_chest was core_ui_container).
  //
  // Placement: sentinel slots 0-1, button slot 2, text cells 3-4 -> inventory_size 5.
  "namespace": "core_counter",

  "screen": {
    "type": "panel",
    "size": [54, 50],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "bg@core_ui_shapes.nineslice": { "$texture": "textures/ui/dialog_background_opaque" } },
      { "label_1@core_ui_shapes.label": { "offset": [6, 6], "$text": "COUNTER" } },
      {
        // Live text: one host per character (collection_index is only accepted
        // on a direct child of a control declaring collection_name).
        "label_2": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "offset": [6, 20],
          "size": [12, 10],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "controls": [
            { "cell_0@core_ui_chest.text_host": { "controls": [{ "glyph@core_counter.text_1": { "collection_index": 3 } }] } },
            { "cell_1@core_ui_chest.text_host": { "controls": [{ "glyph@core_counter.text_1": { "collection_index": 4 } }] } }
          ]
        }
      },
      {
        // The button IS a container slot; $cell picks the face-bearing cell below.
        "button_1@core_ui_chest.slot_host": {
          "offset": [6, 34],
          "size": [12, 10],
          "$slot": 2,
          "$cell": "core_counter.button_1"
        }
      }
    ]
  },

  // Carrier: a text cell. Reads its slot's stack size, builds `core.ui.c.<n>`,
  // and localizes it; the generated .lang turns the key into the glyph.
  "text_1": {
    "type": "label",
    "size": ["default", "default"],
    "text": "#channel_text",
    "localize": true,
    "font_type": "default",
    "font_size": "small",
    "font_scale_factor": 1.0,
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "container_items" },
      { "binding_name": "#inventory_stack_count", "binding_name_override": "#channel_raw", "binding_type": "collection", "binding_collection_name": "container_items" },
      { "binding_type": "view", "source_property_name": "('core.ui.c.' + #channel_raw)", "target_property_name": "#channel_text" }
    ]
  },

  // The look: four state images composed from the nineslice shape, plus the
  // baked children. Identical to the form host's face.
  "button_1_face": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      { "default@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled" } },
      { "hover@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled", "visible": false } },
      { "pressed@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled", "visible": false } },
      { "locked@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled", "visible": false } },
      {
        "content": {
          "type": "panel",
          "size": ["100%", "100%"],
          "layer": 12,
          "controls": [{ "label_3@core_ui_shapes.label": { "offset": [0, 0], "$text": "+1" } }]
        }
      }
    ]
  },

  // The mechanism: `enabled` is whether the slot holds the transport item
  // (repeating_command_block, aux 188 << 16 = 12320768) or the guard. The
  // press surface exists only while enabled; disabled shows the face alone.
  "button_1": {
    "type": "panel",
    "size": [12, 10],
    "controls": [
      {
        "enabled": {
          "type": "panel",
          "size": ["100%", "100%"],
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "container_items" },
            { "binding_name": "#item_id_aux", "binding_name_override": "#btn_aux", "binding_type": "collection", "binding_collection_name": "container_items" },
            { "binding_type": "view", "source_property_name": "(#btn_aux = 12320768)", "target_property_name": "#visible" }
          ],
          "controls": [
            {
              "item@core_ui_chest.cell": {
                "size": [12, 10],
                "$cell_image_size": [12, 10],
                "$item_collection_name": "container_items",
                "$background_images": "core_counter.button_1_face",
                "$item_renderer": "core_ui_shapes.empty",
                "$button_ref": "core_ui_chest.press_button",
                "$stack_count_required": false,
                "$durability_bar_required": false
              }
            }
          ]
        }
      },
      {
        "disabled": {
          "type": "panel",
          "size": ["100%", "100%"],
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "container_items" },
            { "binding_name": "#item_id_aux", "binding_name_override": "#btn_aux", "binding_type": "collection", "binding_collection_name": "container_items" },
            { "binding_type": "view", "source_property_name": "(not (#btn_aux = 12320768))", "target_property_name": "#visible" }
          ],
          "controls": [{ "face@core_counter.button_1_face": {} }]
        }
      }
    ]
  }
}
