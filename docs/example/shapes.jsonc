{
  // The vocabulary this screen uses. Shipped once in the render pack.
  //
  // A shape has NO bindings and NO children: it is a leaf a compiled screen
  // references by name, overriding static props through $vars. (A derived
  // control's `bindings` and `controls` arrays REPLACE its base's, so a shape
  // never owns either.) Anything that reads a value at runtime is a carrier
  // definition the compiled screen emits itself, per host.
  "namespace": "core_ui_shapes",

  "nineslice": {
    "type": "image",
    "$texture|default": "textures/ui/unstyled",
    "texture": "$texture",
    "size": ["100%", "100%"],
    "keep_ratio": false,
    "layer": 1
  },

  "label": {
    "type": "label",
    "$text|default": "",
    "$font|default": "default",
    "$scale|default": 1.0,
    "$shadow|default": false,
    "text": "$text",
    "localize": false,
    "font_type": "$font",
    "font_size": "small",
    "font_scale_factor": "$scale",
    "shadow": "$shadow",
    "size": ["default", "default"],
    "anchor_from": "top_left",
    "anchor_to": "top_left"
  },

  // A control with no size and no content: what a button mounts where an
  // item renderer would go, so the transport item is never drawn.
  "empty": {
    "type": "panel",
    "size": [0, 0]
  }
}
