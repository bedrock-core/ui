{
  // counter.form.screen.tsx compiled for the form-action host. PROPOSED:
  // the mount and the entry mechanism are spikes S1-S2 in 09-plan.
  //
  // Same look as the chest output: the same shape references, the same face.
  // Only the mechanism differs: a live cell reads one `form_buttons` entry
  // whose text is that cell's live fields and nothing else. A cell with one
  // live field decodes with zero slicing. Fully static cells have no entry.
  //
  // Placement: entry 0 = label_2 text; entry 1 = button_1 (press + enabled).
  // The title carries `core1:core_counter` (encoding 1, the screen's key).
  "namespace": "core_counter",

  "screen": {
    "type": "panel",
    "size": [54, 50],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "bg@core_ui_shapes.nineslice": { "$texture": "textures/ui/dialog_background_opaque" } },
      { "label_1@core_ui_shapes.label": { "offset": [6, 6], "$text": "COUNTER" } },
      {
        // Live text: the entry text IS the value. The runtime writes it with a
        // leading section code, because a digit-leading label renders blank.
        "label_2@core_ui_form.entry_host": {
          "offset": [6, 20],
          "size": [12, 10],
          "$entry": 0,
          "$reader": "core_counter.text_1"
        }
      },
      {
        "button_1@core_ui_form.entry_host": {
          "offset": [6, 34],
          "size": [12, 10],
          "$entry": 1,
          "$reader": "core_counter.button_1"
        }
      }
    ]
  },

  // Carrier: a label bound straight to its entry. No header, no type, no
  // offsets: the compiled cell already knows what it is.
  "text_1": {
    "type": "label",
    "size": ["default", "default"],
    "text": "#form_button_text",
    "localize": false,
    "font_type": "default",
    "font_size": "small",
    "font_scale_factor": 1.0,
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_type": "collection", "binding_collection_name": "form_buttons" }
    ]
  },

  // The mechanism: a real button whose press is the engine's form click on
  // this entry, and whose `enabled` is the entry's one character.
  "button_1": {
    "type": "button",
    "size": [12, 10],
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "pressed",
    "locked_control": "locked",
    "sound_name": "random.click",
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
      { "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
    ],
    "enabled": "#enabled",
    "bindings": [
      { "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
      { "binding_name": "#form_button_text", "binding_name_override": "#entry", "binding_type": "collection", "binding_collection_name": "form_buttons" },
      { "binding_type": "view", "source_property_name": "(#entry = '1')", "target_property_name": "#enabled" }
    ],
    "controls": [
      { "default@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled" } },
      { "hover@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled" } },
      { "pressed@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled" } },
      { "locked@core_ui_shapes.nineslice": { "$texture": "textures/ui/unstyled" } },
      {
        "content": {
          "type": "panel",
          "size": ["100%", "100%"],
          "layer": 12,
          "controls": [{ "label_3@core_ui_shapes.label": { "offset": [0, 0], "$text": "+1" } }]
        }
      }
    ]
  }
}
