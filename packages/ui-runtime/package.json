{
	"name": "@bedrock-core/ui-runtime",
	"version": "0.11.0",
	"description": "@bedrock-core/ui runtime",
	"keywords": [
		"ui",
		"api",
		"minecraft",
		"bedrock",
		"typescript",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/ui",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./container": {
			"types": "./src/hosts/chest/index.ts",
			"import": "./src/hosts/chest/index.ts"
		},
		"./entity": {
			"types": "./src/entity/index.ts",
			"import": "./src/entity/index.ts"
		},
		"./compile": {
			"types": "./src/compile.ts",
			"import": "./src/compile.ts"
		},
		"./jsx-runtime": {
			"types": "./src/jsx/jsx-runtime.ts",
			"import": "./src/jsx/jsx-runtime.ts"
		},
		"./jsx-dev-runtime": {
			"types": "./src/jsx/jsx-dev-runtime.ts",
			"import": "./src/jsx/jsx-dev-runtime.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"generate:font-metrics": "node ./scripts/generate-font-metrics.mjs",
		"lint": "eslint .",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@bedrock-core/i18n": "*",
		"@minecraft/server": "*",
		"@minecraft/server-ui": "*",
		"@vitest/coverage-v8": "*",
		"opentype.js": "*",
		"typescript": "*",
		"vitest": "*"
	},
	"peerDependencies": {
		"@bedrock-core/i18n": "*",
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0",
		"@minecraft/server-ui": "*"
	},
	"peerDependenciesMeta": {
		"@bedrock-core/i18n": {
			"optional": true
		}
	},
	"dependencies": {
		"@bedrock-core/flexbox": "workspace:*"
	}
}
