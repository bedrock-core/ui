{
	"name": "@bedrock-core/config",
	"version": "0.2.0",
	"description": "The bedrock-core addon list + config + guide UI: one realm serves it for every registered addon",
	"keywords": [
		"minecraft",
		"bedrock",
		"cross-addon",
		"config",
		"ui",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/ui",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./i18n/*": {
			"types": "./src/i18n/*.ts",
			"import": "./src/i18n/*.ts"
		}
	},
	"bedrockCore": {
		"i18n": {
			"dir": "./src/i18n",
			"namespace": "core"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"tsconfig.json"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "vitest run",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@bedrock-core/guides": "workspace:*",
		"@bedrock-core/i18n": "workspace:*",
		"@bedrock-core/navigation": "workspace:*",
		"@bedrock-core/ore-styled": "workspace:*",
		"@bedrock-core/server-runtime": "^0.1.0",
		"@bedrock-core/ui-runtime": "workspace:*",
		"@minecraft/server": "^2.8.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"@bedrock-core/guides": "*",
		"@bedrock-core/i18n": "*",
		"@bedrock-core/navigation": "*",
		"@bedrock-core/ore-styled": "*",
		"@bedrock-core/server-runtime": "*",
		"@bedrock-core/ui-runtime": "*",
		"@minecraft/server": "*"
	}
}
