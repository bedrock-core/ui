{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": false,
    "jsxImportSource": "@bedrock-core/ui-runtime",
    "paths": {
      "@bedrock-core/navigation": [
        "../src/index.ts"
      ],
      "@bedrock-core/navigation/core": [
        "../src/core.ts"
      ],
      "@bedrock-core/navigation/runtime": [
        "../src/runtime.ts"
      ],
      "@bedrock-core/ui-runtime": [
        "../../ui-runtime/src/index.ts"
      ],
      "@bedrock-core/ui-runtime/*": [
        "../../ui-runtime/src/*"
      ]
    }
  },
  "include": [
    "./static-navigation.tsx"
  ]
}
