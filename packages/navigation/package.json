{
	"name": "@bedrock-core/navigation",
	"version": "0.13.2",
	"description": "Standalone UI navigation with resident pages and optional Core integration",
	"keywords": [
		"ui",
		"navigation",
		"minecraft",
		"bedrock",
		"typescript",
		"framework"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/ui",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./core": {
			"types": "./src/core.ts",
			"import": "./src/core.ts"
		},
		"./runtime": {
			"types": "./src/runtime.ts",
			"import": "./src/runtime.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"dist/core/api.ts",
		"!src/**/__tests__/**",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx"
	],
	"sideEffects": false,
	"scripts": {
		"build:api": "node scripts/build-api.mjs",
		"build": "yarn build:api && node ../../node_modules/typescript-native/bin/tsc -p tsconfig.json",
		"prepack": "yarn build:api",
		"lint": "yarn build:api && eslint .",
		"test": "yarn build:api && vitest run && yarn test:types",
		"test:types": "yarn build:api && tsc -p type-tests/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@bedrock-core/builder-bundler": "^0.2.0",
		"@minecraft/common": "*",
		"@minecraft/server": "*",
		"eslint": "*",
		"typescript": "*",
		"vitest": "*"
	},
	"peerDependencies": {
		"@bedrock-core/i18n": "*",
		"@bedrock-core/server-runtime": "*",
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0",
		"@minecraft/server-ui": "*"
	},
	"peerDependenciesMeta": {
		"@bedrock-core/i18n": {
			"optional": true
		},
		"@bedrock-core/server-runtime": {
			"optional": true
		}
	},
	"dependencies": {
		"@bedrock-core/observable": "^1.0.0",
		"@bedrock-core/ui-runtime": "workspace:*"
	}
}
