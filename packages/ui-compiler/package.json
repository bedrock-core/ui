{
	"name": "@bedrock-core/ui-compiler",
	"version": "0.1.1",
	"description": "Compiles a solved @bedrock-core/ui tree into static JSON UI",
	"keywords": [
		"ui",
		"compiler",
		"json-ui",
		"minecraft",
		"bedrock",
		"typescript"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": "github:bedrock-core/ui",
	"type": "module",
	"main": "src/index.ts",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"src",
		"!src/**/__tests__/**",
		"!src/**/*.test.ts",
		"!src/**/*.test.tsx",
		"!src/__fixtures__/**"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@bedrock-core/ui-runtime": "workspace:*"
	},
	"devDependencies": {
		"@bedrock-core/i18n": "*",
		"@minecraft/server": "*",
		"@minecraft/server-ui": "*",
		"eslint": "*",
		"typescript": "*",
		"vitest": "*"
	},
	"peerDependencies": {
		"@bedrock-core/i18n": "*",
		"@minecraft/server": ">=2.9.0 || >=2.10.0-0",
		"@minecraft/server-ui": "*"
	},
	"peerDependenciesMeta": {
		"@bedrock-core/i18n": {
			"optional": true
		}
	}
}
