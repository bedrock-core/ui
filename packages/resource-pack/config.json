{
	"$schema": "../../../builder/schemas/config.schema.json",
	"targetVersion": "1.26.50",
	"namespace": "bedrock_core_ui",
	"name": "@bedrock-core_ui",
	"description": "Shared UI textures for @bedrock-core addons",
	"authors": [
		"DrAv0011"
	],
	"packs": {
		"resourcePack": "./packs/RP"
	},
	"bedrockCore": {
		"formatVersion": "1.0.0",
		"profiles": {
			"build": {
				"stages": {
					"generator": false,
					"guides": false,
					"i18n": false,
					"ui-compiler": false,
					"bundler": false
				},
				"export": {
					"resourcePack": "./build/@bedrock-core_ui_rp"
				}
			},
			"default": {
				"stages": {
					"generator": false,
					"guides": false,
					"i18n": false,
					"ui-compiler": false,
					"bundler": false
				},
				"export": {
					"resourcePack": "%APPDATA%/Minecraft Bedrock/Users/Shared/games/com.mojang/development_resource_packs/@bedrock-core_ui_rp"
				}
			}
		},
		"staging": {
			"exclude": [
				"build",
				"dist"
			]
		}
	}
}
