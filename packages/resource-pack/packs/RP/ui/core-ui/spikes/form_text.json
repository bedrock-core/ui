{
	// S7 — which of a form entry's two strings carries a compiled screen's value.
	//
	// A compiled screen reads its values off `#form_button_texture`, the entry's
	// ICON path, with the text set to a fixed decoy. This probe reads the other
	// one: six rows, each bound to `#form_button_text` of its own entry, drawn
	// with `localize: false` so whatever arrives is painted exactly as it
	// arrives. What the rows say answers four questions at once:
	//
	//  0  plain            — does the string arrive verbatim at all
	//  1  section codes    — do `§` codes survive the trip
	//  2  leading digit    — does a value starting with a digit render
	//  3  a .lang key      — does the engine resolve it before the binding, or
	//                        hand over the key for the label to resolve
	//  4  200 characters   — is there a cap short of what a trail needs
	//  5  a RawMessage     — does the CLIENT resolve rawtext into the binding
	//
	// Row 5 is the one that matters: a resolved rawtext means a whole breadcrumb
	// can travel as ONE entry, in the reader's own language, instead of one
	// entry per segment with a box reserved for each.
	//
	// Every row is pressable, so the run also re-proves S1's rule on a text that
	// is NOT the decoy: a press is attributed to its entry only while the button
	// itself carries `collection_details`. The script prints the selection.
	//
	// Gated on its own title marker, mounted beside the library's own container.
	// Nothing vanilla is touched and no shipped screen can reach these.
	"namespace": "core_ui_spike",

	"form_text_root": {
		"type": "panel",
		"size": [ "100%", "100%" ],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"property_bag": { "#visible": false },
		"visible": "#visible",
		"bindings": [
			{ "binding_name": "#title_text" },
			{
				"binding_type": "view",
				"source_property_name": "(('%.11s' * #title_text) = 'bcuiv0008S7')",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"sheet": {
					"type": "panel",
					"size": [ 300, 160 ],
					"anchor_from": "center",
					"anchor_to": "center",
					"controls": [
						{ "bg": { "type": "image", "texture": "textures/ui/ore-styled/card/raised/background", "size": [ "100%", "100%" ], "keep_ratio": false } },
						{ "row_0@core_ui_spike.entry_host": { "offset": [ 4, 4 ], "$address": 0 } },
						{ "row_1@core_ui_spike.entry_host": { "offset": [ 4, 30 ], "$address": 1 } },
						{ "row_2@core_ui_spike.entry_host": { "offset": [ 4, 56 ], "$address": 2 } },
						{ "row_3@core_ui_spike.entry_host": { "offset": [ 4, 82 ], "$address": 3 } },
						{ "row_4@core_ui_spike.entry_host": { "offset": [ 4, 108 ], "$address": 4 } },
						{ "row_5@core_ui_spike.entry_host": { "offset": [ 4, 134 ], "$address": 5 } }
					]
				}
			}
		]
	},

	// `collection_index` is legal only on a direct child of a control declaring
	// `collection_name`, so every row gets a one-child stack above it. The index
	// is the only thing a reference may supply — a binding cannot be
	// parameterised, which is why the bindings live in the row itself.
	"entry_host": {
		"type": "stack_panel",
		"orientation": "vertical",
		"size": [ 292, 24 ],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"collection_name": "form_buttons",
		"controls": [
			{ "cell@core_ui_spike.entry_row": { "collection_index": "$address" } }
		]
	},

	"entry_row": {
		"type": "button",
		"size": [ "100%", "100%" ],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"default_control": "face",
		"hover_control": "face",
		"pressed_control": "face",
		"button_mappings": [
			{ "from_button_id": "button.menu_select", "to_button_id": "button.form_button_click", "mapping_type": "pressed" },
			{ "from_button_id": "button.menu_ok", "to_button_id": "button.form_button_click", "mapping_type": "focused" }
		],
		// S1: without this ON THE BUTTON the press reaches script as a dismissal.
		"bindings": [
			{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
			{
				"binding_name": "#form_button_text",
				"binding_name_override": "#entry_value",
				"binding_type": "collection",
				"binding_collection_name": "form_buttons"
			}
		],
		"controls": [
			{
				"face": {
					"type": "panel",
					"size": [ "100%", "100%" ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"controls": [
						{ "bg": { "type": "image", "texture": "textures/ui/ore-styled/button/secondary/background", "size": [ "100%", "100%" ], "keep_ratio": false } },
						{
							"value": {
								"type": "label",
								"size": [ "100% - 8px", "default" ],
								"offset": [ 4, 0 ],
								"anchor_from": "left_middle",
								"anchor_to": "left_middle",
								"layer": 2,
								"text": "#entry_value",
								"localize": false,
								"font_type": "default",
								"backup_font_type": "UIFont",
								"font_size": "small",
								"font_scale_factor": 1,
								"color": [ 0, 0, 0 ],
								// The value is read ON THE LABEL, not inherited from the button:
								// a bound property belongs to the control that binds it, which is
								// why the shipped carrier binds where the text is drawn.
								"bindings": [
									{ "binding_type": "collection_details", "binding_collection_name": "form_buttons" },
									{
										"binding_name": "#form_button_text",
										"binding_name_override": "#entry_value",
										"binding_type": "collection",
										"binding_collection_name": "form_buttons"
									}
								]
							}
						}
					]
				}
			}
		]
	}
}
