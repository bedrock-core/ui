{
	// A scrolling region: a viewport at the rect the layout solved, over content
	// laid out on its own and taller than the viewport. The client scrolls it;
	// the layout stays frozen. A compiled screen mounts it with its size and
	// offset and names the content through `$scrolling_content`.
	//
	// A SHAPE, not a mechanism: no collection, no bindings, nothing about where
	// it is drawn. A scroll region is the same control on a chest screen and on
	// a form, which is why it lives here rather than beside one host's cells —
	// it started in the chest's namespace only because the chest was the only
	// host that existed.
	"namespace": "core_ui_shapes",

	"scroll": {
		"type": "scroll_view",
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"scroll_speed": 15,
		"scrollbar_track_button": "button.scrollbar_skip_track",
		"scrollbar_touch_button": "button.scrollbar_touch",
		"always_listen_to_input": true,
		"always_handle_pointer": true,
		"always_handle_scrolling": true,
		"scroll_content": "scrolling_content",
		"scroll_view_port": "scrolling_view_port",
		"scrollbar_track": "track",
		"scrollbar_box": "box",
		"scroll_box_and_track_panel": "bar_and_track",
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.scrollbar_touch",
				"mapping_type": "pressed",
				"button_up_right_of_first_refusal": true
			}
		],
		"controls": [
			{
				// The viewport clips the content; the 5-texel track sits to its right.
				"scrolling_view_port": {
					"type": "panel",
					"size": [ "100% - 5px", "100%" ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"clips_children": true,
					"controls": [
						{
							"size_anchor": {
								"type": "panel",
								"size": [ 1, 1 ],
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"controls": [
									{
										"scrolling_content@$scrolling_content": {
											"anchor_from": "top_left",
											"anchor_to": "top_left"
										}
									}
								]
							}
						}
					]
				}
			},
			{ "bar_and_track@core_ui_shapes.scrollbar": {} }
		]
	},

	"scrollbar": {
		"type": "panel",
		"size": [ 5, "100%" ],
		"anchor_from": "right_middle",
		"anchor_to": "right_middle",
		"controls": [
			{
				"track": {
					"type": "scroll_track",
					"size": [ 5, "100%" ],
					"anchor_from": "center",
					"anchor_to": "center",
					"button_mappings": [
						{
							"from_button_id": "button.menu_select",
							"to_button_id": "button.scrollbar_skip_track",
							"mapping_type": "pressed"
						}
					],
					"controls": [
						{ "bar_indent@core_ui_shapes.scroll_rail": { "anchor_from": "center", "anchor_to": "center" } }
					]
				}
			},
			{
				"box": {
					"type": "scrollbar_box",
					"size": [ 5, "20%" ],
					"anchor_from": "top_middle",
					"anchor_to": "top_middle",
					"draggable": "vertical",
					"contained": true,
					"button_mappings": [
						{
							"from_button_id": "button.menu_select",
							"to_button_id": "button.menu_select",
							"mapping_type": "pressed",
							"button_up_right_of_first_refusal": true
						}
					],
					"controls": [
						{ "handle@core_ui_shapes.scroll_handle": { "anchor_from": "center", "anchor_to": "center" } }
					]
				}
			}
		]
	},

	"scroll_rail": {
		"type": "image",
		"texture": "textures/ui/ScrollRail",
		"size": [ 3, "100%" ],
		"layer": 3
	},

	"scroll_handle": {
		"type": "image",
		"texture": "textures/ui/ScrollHandle",
		"size": [ 5, "100%" ],
		"layer": 4
	}
}
