{
	// Routes HEADER-slot factory entries. The TS side emits `<Image>` cells through
	// `form.header(payload)` on ActionForms (see emitHeader): the native factory routes
	// header entries to this control_id directly, so an image cell instantiates ONLY
	// this slim router + one component — engine-level type routing with none of the
	// 6-variant label_router fan-out or `#type` gating cost.
	//
	// Region gate: same shape as label_router/button_router — the router decodes the
	// cell's region field once ([523-605], direct absolute slice) and hides itself on a
	// mismatch. Headers expose the same `#form_button_text` payload channel as labels
	// (both are custom elements of the form_buttons collection).
	//
	// Modal images do NOT come through here — the modal backend emits them through the
	// label slot (form_components/label.json keeps its image variant).
	"namespace": "core_ui_common",
	"header_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"$region_filter|default": 0,
		"visible": "#visible",
		"property_bag": {
			"#visible": true
		},
		"bindings": [
			{
				"binding_name": "#form_button_text",
				"binding_type": "collection",
				"binding_collection_name": "form_buttons",
				"binding_name_override": "#payload"
			},
			{
				/* region (number) - field 8, DIRECT slice at [523-605] */
				"binding_type": "view",
				"source_property_name": "('%.523s' * #payload)",
				"target_property_name": "#skip_to_region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#payload - #skip_to_region)",
				"target_property_name": "#rem_at_region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_at_region)",
				"target_property_name": "#raw_region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_region) - ('%.2s' * #raw_region) - ';') * 1)",
				"target_property_name": "#region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#region = $region_filter)",
				"target_property_name": "#visible",
				"binding_condition": "once"
			}
		],
		"controls": [
			{
				"image@core_ui_components.image": {}
			}
		]
	},
	// Per-region router variants, same pattern as label_router_rN / button_router_rN.
	"header_router_r1@header_router": {
		"$region_filter": 1
	},
	"header_router_r2@header_router": {
		"$region_filter": 2
	}
}
