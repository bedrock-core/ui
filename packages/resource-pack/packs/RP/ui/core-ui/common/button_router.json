{
	// Routes button-type factory entries to the appropriate interactive component.
	// Parallel to label_router which handles label-type entries.
	//
	// REGION GATE LIVES HERE (Stage 1 perf shape, see label_router): the router decodes
	// the cell's region field once and hides itself on a mismatch, so wrong-region cells
	// never run the button decodes. The base control no longer decodes
	// region. Region 0 is the default; pooled scrolls point their factories at the _rN
	// variants below.
	"namespace": "core_ui_common",
	"button_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"$region_filter|default": 0,
		"visible": "#visible",
		"property_bag": {
			"#visible": true
		},
		"bindings": [
			{
				"binding_name": "#form_button_text",
				"binding_type": "collection",
				"binding_collection_name": "form_buttons",
				"binding_name_override": "#payload"
			},
			{
				/* region (number) - field 8, DIRECT slice at [523-605] */
				"binding_type": "view",
				"source_property_name": "('%.523s' * #payload)",
				"target_property_name": "#skip_to_region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#payload - #skip_to_region)",
				"target_property_name": "#rem_at_region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_at_region)",
				"target_property_name": "#raw_region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_region) - ('%.2s' * #raw_region) - ';') * 1)",
				"target_property_name": "#region",
				"binding_condition": "once"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#region = $region_filter)",
				"target_property_name": "#visible",
				"binding_condition": "once"
			}
		],
		"controls": [
			{
				"button@core_ui_components.button": {}
			}
		]
	},
	// Per-region router variants. A factory's control_ids cannot forward the
	// collection_panel's $region_filter into the controls it instantiates, so each pooled
	// scroll points its factory at the variant whose $region_filter matches its scroll
	// index. The pool is capped at 2 slots; add _r3 here when growing it.
	"button_router_r1@button_router": {
		"$region_filter": 1
	},
	"button_router_r2@button_router": {
		"$region_filter": 2
	}
}
