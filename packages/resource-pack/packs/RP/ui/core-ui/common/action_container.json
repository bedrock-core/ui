{
	// Two modes, by scroll count:
	//  • 0 nested scrolls → the MAIN scroll (scroll_root) wraps & scrolls everything (region 0).
	//  • ≥1 nested scrolls → the screen is fixed (region-0 content fits) and the POOL of custom
	//    scrolls (scroll_pool, gated on ≥2 scrolls) renders as a sibling over the content area.
	// Both are 328px-wide, centred by the literal 50% - 164px offset.
	"namespace": "core_ui_common",
	"action_container": {
		"type": "panel",
		"size": [
			"100%",
			"100%"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"$protocol_header": "bcuiv0008",
		"bindings": [
			{
				"binding_name": "#title_text"
			},
			{
				/* Render only for bcui forms — visible when the title carries the protocol header */
				"binding_type": "view",
				"source_property_name": "(not ((#title_text - $protocol_header) = #title_text))",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			/* Two ways a screen reaches this container, and the title decides which.
			   A serialized screen is drawn by the interpreter below; a COMPILED one
			   is already in an addon's pack and is only named. Each gates itself on
			   the title, so exactly one of them draws — see core-ui/form/mount.json. */
			{
				/* The interpreter draws a 328px canvas from this box's left edge, so
				   the offset that centres it is ITS offset — on the container it also
				   shifted the compiled mount, which centres its own canvas in the full
				   content box and came out pushed right by (50% - 164px). */
				"interpreted@core_ui_form.interpreted": {
					"offset": [
						"50% - 164px",
						"0%"
					]
				}
			},
			{
				"compiled@core_ui_form.claimed": {}
			}
		]
	}
}
