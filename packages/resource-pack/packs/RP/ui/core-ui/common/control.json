{
	"namespace": "core_ui_control",
	// THE base cell control every component extends: it owns the ENTIRE generic
	// control-block decode ([0-1023]: header, type, width→#size_binding_x,
	// height→#size_binding_y, x/y→#anchored_offset_value_*, visible, enabled,
	// background, region) plus the region gate — so components never copy/paste the
	// location decode again.
	//
	// WHY extension works here and the old copy/paste didn't: JSON UI does NOT merge
	// arrays on derivation — a derived control that declares its own `bindings` REPLACES
	// the base's entirely. So the base must own the WHOLE bindings array, and everything
	// component-specific rides $vars instead:
	//   • $type_gate     — the per-component #type visibility gate, passed as a WHOLE
	//                      expression (vanilla-proven pattern: crafting screens pass full
	//                      expressions via "$source_property_name"). A component sets it
	//                      to "(#pre_visible and (#type = '<its-type>'))".
	//   • $payload_collection / $payload_binding / $cell_details_binding_type — payload
	//                      source; defaults serve the ActionForm (form_buttons), the modal
	//                      label_router overrides to custom_form + #custom_text.
	//   • $region_filter  — scroll region gate (substituted per scroll instance).
	// Derived controls may set `type`, `layer`, and their OWN `controls` children (the
	// base declares none, so a derived `controls` array replaces nothing).
	//
	// NOTE: computed #bindings do NOT propagate to children — a child that needs payload
	// fields (e.g. a bg texture) must bind + decode them itself (see panel_bg).
	"control": {
		"type": "panel",
		"$type_gate|default": "(#pre_visible and (#type = 'panel'))",
		"$payload_collection|default": "form_buttons",
		"$payload_binding|default": "#form_button_text",
		"$cell_details_binding_type|default": "none",
		"$region_filter|default": 0,
		"$normalize": 1.0,
		"size": [
			0,
			0
		],
		"layer": 0,
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#size_binding_x": 0.0,
			"#size_binding_y": 0.0,
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"visible": "#visible",
		"enabled": "#enabled",
		"bindings": [
			{
				"binding_type": "$cell_details_binding_type",
				"binding_collection_name": "$payload_collection"
			},
			{
				"binding_name": "$payload_binding",
				"binding_type": "collection",
				"binding_collection_name": "$payload_collection",
				"binding_name_override": "#payload"
			},
			{
				/* --- strip protocol header (9 chars) --- */
				"binding_type": "view",
				"source_property_name": "('%.9s' * #payload)",
				"target_property_name": "#protocol_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#payload - #protocol_header)",
				"target_property_name": "#rem_after_header"
			},
			{
				/* --- type (string) - field 0 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_header)",
				"target_property_name": "#raw_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_header - #raw_type)",
				"target_property_name": "#rem_after_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_type) - ('%.2s' * #raw_type) - ';')",
				"target_property_name": "#type"
			},
			{
				/* --- width (int) - field 1 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_type)",
				"target_property_name": "#raw_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_type - #raw_width)",
				"target_property_name": "#rem_after_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_width) - ('%.2s' * #raw_width) - ';')",
				"target_property_name": "#size_binding_x"
			},
			{
				/* --- height (int) - field 2 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_width)",
				"target_property_name": "#raw_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_width - #raw_height)",
				"target_property_name": "#rem_after_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_height) - ('%.2s' * #raw_height) - ';')",
				"target_property_name": "#size_binding_y"
			},
			{
				/* --- x (int) - field 3 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_height)",
				"target_property_name": "#raw_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_height - #raw_x)",
				"target_property_name": "#rem_after_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_x) - ('%.2s' * #raw_x) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_x"
			},
			{
				/* --- y (float) - field 4 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_x)",
				"target_property_name": "#raw_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_x - #raw_y)",
				"target_property_name": "#rem_after_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_y) - ('%.2s' * #raw_y) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_y"
			},
			{
				/* --- visible (boolean) - field 5 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_y)",
				"target_property_name": "#raw_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_y - #raw_visible)",
				"target_property_name": "#rem_after_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_visible) - ('%.2s' * #raw_visible) - ';')",
				"target_property_name": "#pre_visible"
			},
			{
				/* Per-component type gate — the ONLY component-specific token in this whole
				   decode, injected as a full expression via $type_gate. */
				"binding_type": "view",
				"source_property_name": "$type_gate",
				"target_property_name": "#visible_pre_region"
			},
			{
				/* --- enabled (boolean) - field 6 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_visible)",
				"target_property_name": "#raw_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_visible - #raw_enabled)",
				"target_property_name": "#rem_after_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_enabled) - ('%.2s' * #raw_enabled) - ';')",
				"target_property_name": "#enabled"
			},
			{
				/* --- background (string, 83 bytes) - field 7 [440-522] --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_enabled)",
				"target_property_name": "#raw_background"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_background) - ('%.2s' * #raw_background) - ';')",
				"target_property_name": "#background"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not (#background = ''))",
				"target_property_name": "#bg_visible"
			},
			{
				/* --- region (number) - field 8 [523-605]: skip background (83) to reach it --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_enabled)",
				"target_property_name": "#skip_bg_for_region"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_enabled - #skip_bg_for_region)",
				"target_property_name": "#rem_at_region"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_at_region)",
				"target_property_name": "#raw_region"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_region) - ('%.2s' * #raw_region) - ';') * 1)",
				"target_property_name": "#region"
			},
			{
				/* Gate on the active scroll region: $region_filter is substituted per scroll instance */
				"binding_type": "view",
				"source_property_name": "(#visible_pre_region and (#region = $region_filter))",
				"target_property_name": "#visible"
			}
		]
	},
	//
	// One shared state-face: a full-size bg image that self-decodes its texture from the
	// payload at $face_skip (a WHOLE skip expression, like $type_gate — array-merge rules
	// forbid appending bindings, so the offset rides the expression var). Replaces the
	// four copy/pasted default/hover/pressed/locked blocks each state-styled control
	// carried (button state children; the dropdown closed-box faces are the same shape).
	// Faces are CHILDREN and must self-decode: computed bindings don't propagate down.
	// The $payload_* / $cell_details_binding_type names deliberately match the base
	// control's: a face nested under a modal cell picks the cell's custom_form overrides
	// out of the instantiation scope automatically; the defaults serve the ActionForm.
	// An empty decoded texture self-hides the image (unstyled state falls through to
	// whatever sits beneath).
	// state_face preset for MODAL cells: payload from custom_form/#custom_text. Faces
	// only pass their $face_skip. (Details stay "none" — the face reads the row via
	// walk-up, same as the original copy/pasted blocks.)
	"modal_state_face@core_ui_control.state_face": {
		"$payload_collection": "custom_form",
		"$payload_binding": "#custom_text"
	},
	"state_face": {
		"type": "panel",
		"size": [
			"100%",
			"100%"
		],
		"anchor_from": "center",
		"anchor_to": "center",
		"$face_skip|default": "('%.440s' * #payload)",
		"$payload_collection|default": "form_buttons",
		"$payload_binding|default": "#form_button_text",
		"$cell_details_binding_type|default": "none",
		"controls": [
			{
				"bg": {
					"type": "image",
					"size": [
						"100%",
						"100%"
					],
					"offset": [
						0,
						0
					],
					"fill": false,
					"anchor_to": "center",
					"anchor_from": "center",
					"texture": "#texture",
					"visible": "#visible",
					"alpha": 1,
					"bindings": [
						{
							"binding_type": "$cell_details_binding_type",
							"binding_collection_name": "$payload_collection"
						},
						{
							"binding_name": "$payload_binding",
							"binding_type": "collection",
							"binding_collection_name": "$payload_collection",
							"binding_name_override": "#payload"
						},
						{
							/* skip to this face's texture field — the offset lives in $face_skip */
							"binding_type": "view",
							"source_property_name": "$face_skip",
							"target_property_name": "#skip_to_face"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#payload - #skip_to_face)",
							"target_property_name": "#rem_at_face"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_face)",
							"target_property_name": "#raw_face"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_face) - ('%.2s' * #raw_face) - ';')",
							"target_property_name": "#texture"
						},
						{
							"binding_type": "view",
							"source_property_name": "(not (#texture = ''))",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	},
	// THE shared text base. Owns: the visual label properties (white, font_size small,
	// the backup_font_type font-alias guard) AND the whole decode + positioning:
	//   • ONE offset: $label_skip points at the start of the serialized label GROUP
	//     (TS labelPayloadFields): [text, fontType, fontScale, x, y] — five contiguous
	//     83-byte fields decoded SEQUENTIALLY, so consumers never pass per-field offsets.
	//     Defaults match the text component (group at [1024]).
	//   • $native_binding/$native_target: an optional second collection channel for
	//     labels whose TEXT is native (input value/placeholder). Defaults are a no-op
	//     (binds the payload again into a throwaway var). Such labels override the
	//     text property to the native name; the group text slot decodes unused.
	//   • POSITION: the group x/y feed #anchored_offset_value_* with top_left anchors —
	//     the ONLY proven anchored-offset combo. Host every label_base instance inside a
	//     [1,1] frame (the px-mapping rule); pin the frame wherever the offset should
	//     originate (cell top-left, box left-middle, …).
	// text_alignment is NOT bindable (in-game bisected) → $label_alignment var; consumers
	// needing data-driven alignment gate static variants and declare their OWN bindings
	// (wholesale-replace is the supported opt-out — see form_shared.option_label and the
	// dropdown current-value label). Payload binding condition is "always".
	// NOT extending this: the modal submit/exit button labels (no scale binding).
	"label_base": {
		"type": "label",
		"text": "#text",
		"color": [1, 1, 1, 1],
		"font_size": "small",
		"backup_font_type": "UIFont",
		"font_scale_factor": "#font_scale_factor",
		"$label_alignment|default": "left",
		"text_alignment": "$label_alignment",
		"size": ["default", "default"],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"$payload_collection|default": "form_buttons",
		"$payload_binding|default": "#form_button_text",
		"$cell_details_binding_type|default": "none",
		"$details_collection|default": "",
		"$label_skip|default": "('%.1024s' * #payload)",
		"$native_binding|default": "#form_button_text",
		"$native_target|default": "#label_native_unused",
		"bindings": [
			{
				/* fetch shape is the custom_dropdown-PROVEN one: collection binding FIRST,
				   details second with an EMPTY name (the toggle-proven form) — a details
				   binding NAMED custom_dropdown, placed first, hard-crashed the ore form. */
				"binding_name": "$payload_binding",
				"binding_type": "collection",
				"binding_condition": "always",
				"binding_collection_name": "$payload_collection",
				"binding_name_override": "#payload"
			},
			{
				"binding_type": "$cell_details_binding_type",
				"binding_collection_name": "$details_collection"
			},
			{
				/* optional native text channel (no-op by default) */
				"binding_name": "$native_binding",
				"binding_type": "collection",
				"binding_condition": "always",
				"binding_collection_name": "$payload_collection",
				"binding_name_override": "$native_target"
			},
			{
				/* label group, decoded sequentially from $label_skip */
				"binding_type": "view",
				"source_property_name": "$label_skip",
				"target_property_name": "#skip_to_label"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#payload - #skip_to_label)",
				"target_property_name": "#label_rem0"
			},
			{
				/* group slot 1: text */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem0)",
				"target_property_name": "#raw_label_text"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_label_text) - ('%.2s' * #raw_label_text) - ';')",
				"target_property_name": "#text"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem0 - #raw_label_text)",
				"target_property_name": "#label_rem1"
			},
			{
				/* group slot 2: fontType (canonical #font_type alias) */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem1)",
				"target_property_name": "#raw_label_font"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_label_font) - ('%.2s' * #raw_label_font) - ';')",
				"target_property_name": "#font_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem1 - #raw_label_font)",
				"target_property_name": "#label_rem2"
			},
			{
				/* group slot 3: fontScaleFactor */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem2)",
				"target_property_name": "#raw_label_scale"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_label_scale) - ('%.2s' * #raw_label_scale) - ';')",
				"target_property_name": "#font_scale_factor"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem2 - #raw_label_scale)",
				"target_property_name": "#label_rem3"
			},
			{
				/* group slot 4: x -> anchored X (needs the [1,1] host frame) */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem3)",
				"target_property_name": "#raw_label_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_label_x) - ('%.2s' * #raw_label_x) - ';') * 1)",
				"target_property_name": "#anchored_offset_value_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem3 - #raw_label_x)",
				"target_property_name": "#label_rem4"
			},
			{
				/* group slot 5: y -> anchored Y */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem4)",
				"target_property_name": "#raw_label_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_label_y) - ('%.2s' * #raw_label_y) - ';') * 1)",
				"target_property_name": "#anchored_offset_value_y"
			}
		]
	},
	"unused": {
		"type": "panel",
		"size": [
			0,
			0
		]
	}
}