{
	// ─────────────────────────────────────────────────────────────────────────────
	// MINIMAL ISOLATION BUILD — TOGGLE ONLY.
	//
	// Everything except `toggle` is routed to core_ui_common.unused so we can debug the
	// positioning of a single native control without the noise of every other type.
	// Once toggle positions correctly from its decoded geometry, the other controls get
	// re-added the same way.
	//
	// The native modal's custom_form renders here (server_form.main_screen_content factory
	// maps `custom_form` → modal_container). Toggle geometry is decoded from #custom_text
	// (header 9 → type 83 → width 83 → height 83 → x 83 → y 83) into the property_bag the
	// engine maps to size + anchored offset (use_anchored_offset).
	// ─────────────────────────────────────────────────────────────────────────────
	"namespace": "core_ui_common",
	"modal_container": {
		"type": "stack_panel",
		"orientation": "vertical",
		"size": [
			"100%",
			"100%"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"offset": [
			"50% - 164px",
			"0%"
		],
		"$protocol_header": "bcuiv0007",
		"bindings": [
			{
				"binding_name": "#title_text"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not ((#title_text - $protocol_header) = #title_text))",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"modal_content@core_ui_common.modal_scroll": {}
			},
			{
				"submit_button@common_buttons.light_text_button": {
					"$pressed_button_name": "button.submit_custom_form",
					"anchor_from": "bottom_left",
					"anchor_to": "bottom_left",
					"size": [
						"100%",
						32
					],
					"$button_text": "#submit_text",
					"$button_text_binding_type": "global",
					"$button_binding_condition": "once",
					"bindings": [
						{
							"binding_name": "#submit_button_visible",
							"binding_name_override": "#visible"
						}
					]
				}
			}
		]
	},
	// ── Modal content scaffold ─────────────────────────────────────────────────────
	// viewport(clips) → size_anchor[1,1] → modal_content_panel(328px × decoded-height) →
	// modal_generated_contents(collection overlay). Mirrors the ActionForm scroll exactly:
	// scrolling_view_port → size_anchor[1,1] → scroll_content[328px,decoded] → buttons_collection.
	"modal_scroll": {
		"type": "scroll_view",
		"size": [
			"328px",
			"95%"
		],
		"offset": [
			0,
			"1%"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"scroll_speed": 15,
		"scrollbar_track_button": "button.scrollbar_skip_track",
		"scrollbar_touch_button": "button.scrollbar_touch",
		"always_listen_to_input": true,
		"always_handle_pointer": true,
		"always_handle_scrolling": true,
		"scroll_content": "scrolling_content",
		"scroll_view_port": "scrolling_view_port",
		"scrollbar_track": "track",
		"scrollbar_box": "box",
		"scroll_box_and_track_panel": "bar_and_track",
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.scrollbar_touch",
				"mapping_type": "pressed",
				"button_up_right_of_first_refusal": true
			}
		],
		"controls": [
			{
				"viewport": {
					"type": "panel",
					"size": [
						"100%",
						"100%"
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"clips_children": true,
					"controls": [
						{
							"size_anchor": {
								"type": "panel",
								"size": [
									1,
									1
								],
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"controls": [
									{
										"scrolling_content@core_ui_common.modal_scroll_content": {
											"anchor_from": "top_left",
											"anchor_to": "top_left"
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"bar_and_track@core_ui_screens.scrollbar": {}
			}
		]
	},
	"modal_scroll_content": {
		"type": "panel",
		"size": [
			"328px",
			0
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"property_bag": {
			"#size_binding_y": 0.0
		},
		"bindings": [
			{
				"binding_name": "#title_text"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.9s' * #title_text)",
				"target_property_name": "#protocol_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#title_text - #protocol_header)",
				"target_property_name": "#rem_after_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.498s' * #rem_after_header)",
				"target_property_name": "#pre_extent"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_header - #pre_extent)",
				"target_property_name": "#at_extent"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #at_extent)",
				"target_property_name": "#raw_extent"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_extent) - ('%.2s' * #raw_extent) - ';') * 1)",
				"target_property_name": "#size_binding_y"
			}
		],
		"controls": [
			{
				"modal_collection": {
					"type": "collection_panel",
					"size": [
						"100%",
						"100%"
					],
					"offset": [
						"-50%",
						"-25%"
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"factory": {
						"name": "buttons",
						"control_ids": {
							"label": "@core_ui_common.unused",
							"toggle": "@core_ui_form_components.toggle_router",
							"slider": "@core_ui_common.unused",
							"step_slider": "@core_ui_common.unused",
							"dropdown": "@core_ui_common.unused",
							"input": "@core_ui_common.unused",
							"header": "@core_ui_common.unused",
							"divider": "@core_ui_common.unused"
						}
					},
					"collection_name": "custom_form",
					"bindings": [
						{
							"binding_name": "#custom_form_length",
							"binding_name_override": "#collection_length"
						}
					]
				}
			}
		]
	}
}