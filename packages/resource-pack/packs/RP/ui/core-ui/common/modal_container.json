										"binding_type": "view",
										"source_property_name": "(#title_text - #skip_submit_y)",
										"target_property_name": "#rem_submit_y"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.83s' * #rem_submit_y)",
