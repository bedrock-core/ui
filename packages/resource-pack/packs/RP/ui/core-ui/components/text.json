{
	"namespace": "core_ui_components",
	// Extends the shared base (core_ui_control.control). The base owns the generic
	// control-block decode; the text/font fields (component fields 1-3: text [1024],
	// fontType [1107], fontScaleFactor [1190]) are decoded by the label CHILD (computed
	// bindings don't propagate to children, and a derived `bindings` array would REPLACE
	// the base's — so component decode lives on children, same as panel_bg and the modal
	// dropdown's current-value label, both in-game proven). Payload-source $vars pass
	// through instantiation into both the base bindings and the child.
	"text@core_ui_control.control": {
		"layer": 100,
		"$type_gate": "(#pre_visible and (#type = 'text'))",
		"controls": [
			{
				/* Extends the shared text base (core_ui_control.label_base): text/#text, white,
				   font_size small, backup_font_type (font-alias guard) and the
				   #font_scale_factor hook come from there — only the decode + geometry live
				   here. */
				"txt@core_ui_control.label_base": {
					"size": [
						"100%",
						"100%"
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"localize": true
				}
			}
		]
	}
}
