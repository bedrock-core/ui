{
	"namespace": "core_ui_components",
	// Extends the shared base (core_ui_control.control). The base owns the generic
	// control-block decode; the text/font fields (component fields 1-3: text [1024],
	// fontType [1107], fontScaleFactor [1190]) are decoded by the label CHILD (computed
	// bindings don't propagate to children, and a derived `bindings` array would REPLACE
	// the base's — so component decode lives on children, same as panel_bg and the modal
	// dropdown's current-value label, both in-game proven). Payload-source $vars pass
	// through instantiation into both the base bindings and the child.
	"text@core_ui_control.control": {
		"layer": 100,
		"$type_gate": "(#pre_visible and (#type = 'text'))",
		"controls": [
			{
				"txt": {
					"type": "label",
					"size": [
						"100%",
						"100%"
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"text": "#text",
					/* NO literal "font_type" property: the engine resolves it as a font ALIAS at
					   screen load (before bindings run) → "Could not find font alias" spam. Bind
					   into the CANONICAL #font_type below; backup_font_type is the pre-binding
					   fallback. */
					"backup_font_type": "UIFont",
					"font_scale_factor": "#font_scale_factor",
					"font_size": "small",
					"localize": true,
					"bindings": [
						{
							"binding_type": "$cell_details_binding_type",
							"binding_collection_name": "$payload_collection"
						},
						{
							"binding_name": "$payload_binding",
							"binding_type": "collection",
							"binding_collection_name": "$payload_collection",
							"binding_name_override": "#payload"
						},
						{
							/* text — component field 1, absolute [1024] */
							"binding_type": "view",
							"source_property_name": "('%.1024s' * #payload)",
							"target_property_name": "#skip_to_text"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#payload - #skip_to_text)",
							"target_property_name": "#rem_at_text"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_text)",
							"target_property_name": "#raw_text"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_text) - ('%.2s' * #raw_text) - ';')",
							"target_property_name": "#text"
						},
						{
							/* fontType — component field 2, absolute [1107] */
							"binding_type": "view",
							"source_property_name": "('%.1107s' * #payload)",
							"target_property_name": "#skip_to_font_type"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#payload - #skip_to_font_type)",
							"target_property_name": "#rem_at_font_type"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_font_type)",
							"target_property_name": "#raw_font_type"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_font_type) - ('%.2s' * #raw_font_type) - ';')",
							"target_property_name": "#font_type"
						},
						{
							/* fontScaleFactor — component field 3, absolute [1190] */
							"binding_type": "view",
							"source_property_name": "('%.1190s' * #payload)",
							"target_property_name": "#skip_to_font_scale"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#payload - #skip_to_font_scale)",
							"target_property_name": "#rem_at_font_scale"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_font_scale)",
							"target_property_name": "#raw_font_scale"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_font_scale) - ('%.2s' * #raw_font_scale) - ';')",
							"target_property_name": "#font_scale_factor"
						}
					]
				}
			}
		]
	}
}
