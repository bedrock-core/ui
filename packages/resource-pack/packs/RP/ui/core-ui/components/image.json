{
	"namespace": "core_ui_components",
	// Extends the shared base (core_ui_common.control). The base owns the generic
	// control-block decode; the texture (component field 1, [1024-1106]) is decoded by the
	// img CHILD (computed bindings don't propagate to children, and a derived `bindings`
	// array would REPLACE the base's — so component decode lives on children, same as
	// panel_bg / the button state faces). Payload-source $vars pass through instantiation
	// into both the base bindings and the child (modal label_router overrides them).
	"image@core_ui_common.control": {
		"layer": 80,
		"$type_gate": "(#pre_visible and (#type = 'image'))",
		"controls": [
			{
				"img": {
					"type": "image",
					"size": [
						"100%",
						"100%"
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "#texture",
					"visible": "#visible",
					/* Decode is `visible` (S2-proven semantics): skipped when the image variant is
					   gated off; when visible it runs once (payload is screen-constant) and
					   self-hides on an empty texture. */
					"bindings": [
						{
							"binding_type": "$cell_details_binding_type",
							"binding_collection_name": "$payload_collection"
						},
						{
							"binding_name": "$payload_binding",
							"binding_type": "collection",
							"binding_collection_name": "$payload_collection",
							"binding_name_override": "#payload"
						},
						{
							/* texture — component field 1, absolute [1024] (header 9 + type 83 +
							   w/h/x/y 4×83 + visible/enabled 2×8 + background 83 + region 83 +
							   reserved 418 = 1024) */
							"binding_type": "view",
							"source_property_name": "('%.1024s' * #payload)",
							"target_property_name": "#skip_to_texture",
							"binding_condition": "visible"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#payload - #skip_to_texture)",
							"target_property_name": "#rem_at_texture",
							"binding_condition": "visible"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_texture)",
							"target_property_name": "#raw_texture",
							"binding_condition": "visible"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_texture) - ('%.2s' * #raw_texture) - ';')",
							"target_property_name": "#texture",
							"binding_condition": "visible"
						},
						{
							"binding_type": "view",
							"source_property_name": "(not (#texture = ''))",
							"target_property_name": "#visible",
							"binding_condition": "visible"
						}
					]
				}
			}
		]
	}
}
