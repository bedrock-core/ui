{
	"namespace": "core_ui_components",
	// FIRST component converted to the shared base (core_ui_control.control owns the
	// entire generic control-block decode — size/position/visible/enabled/region). This
	// control only supplies its type gate + its own children. Payload-source $vars
	// ($payload_collection / $payload_binding / $cell_details_binding_type) pass through
	// instantiation into the base's bindings, so the modal label_router overrides still
	// work unchanged. If this proves out in-game, convert text/image/button/... the same
	// way and delete their copy/pasted decode blocks.
	"panel@core_ui_control.control": {
		"$type_gate": "(#pre_visible and (#type = 'panel'))",
		"controls": [
			{
				"panel_bg": {
					"type": "image",
					"size": ["100%", "100%"],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"fill": true,
					"texture": "#texture",
					"visible": "#visible",
					"bindings": [
						{
							/* decode background directly - computed bindings don't propagate to children */
							"binding_type": "$cell_details_binding_type",
							"binding_collection_name": "$payload_collection"
						},
						{
							"binding_name": "$payload_binding",
							"binding_type": "collection",
							"binding_collection_name": "$payload_collection",
							"binding_name_override": "#payload"
						},
						{
							/* skip 440 bytes: header(9)+type(83)+width(83)+height(83)+x(83)+y(83)+visible(8)+enabled(8) */
							"binding_type": "view",
							"source_property_name": "('%.440s' * #payload)",
							"target_property_name": "#skip_to_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#payload - #skip_to_bg)",
							"target_property_name": "#rem_at_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_bg)",
							"target_property_name": "#raw_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_bg) - ('%.2s' * #raw_bg) - ';')",
							"target_property_name": "#texture"
						},
						{
							"binding_type": "view",
							"source_property_name": "(not (#texture = ''))",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	}
}
