{
	"namespace": "core_ui_components",
	// Extends the shared base (core_ui_common.control) — the base owns the whole generic
	// control-block decode; this control only supplies its type gate + the item child.
	// (Slated for deprecation — left untouched by the Stage-1 perf pass.)
	"item_renderer@core_ui_common.control": {
		"size": [
			16,
			16
		],
		"layer": 90,
		"$type_gate": "(#pre_visible and (#type = 'item_renderer'))",
		"controls": [
			{
				"item": {
					"type": "custom",
					"renderer": "inventory_item_renderer",
					"size": [
						16,
						16
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"bindings": [
						{
							"binding_name": "#form_button_texture",
							"binding_type": "collection",
							"binding_collection_name": "form_buttons"
						},
						{
							"binding_type": "view",
							"source_property_name": "((#form_button_texture - (#form_button_texture % 65536)) / 65536)",
							"target_property_name": "#item_id_aux"
						}
					]
				}
			}
		]
	}
}
