{
	"namespace": "core_ui_components",
	"label_static@core_ui_components.label": {
		"$font_type|default": "default",
		"font_type": "$font_type",
		"bindings": [
			{
				/* the native text channel, the one binding a static label still needs */
				"binding_name": "$native_binding",
				"binding_type": "collection",
				"binding_condition": "always",
				"binding_collection_name": "$payload_collection",
				"binding_name_override": "$native_target"
			}
		]
	},
	"label": {
		"type": "label",
		"text": "#text",
		"color": [
			1,
			1,
			1,
			1
		],
		"font_size": "small",
		"backup_font_type": "UIFont",
		"$scale|default": "#font_scale_factor",
		"font_scale_factor": "$scale",
		/* `shadow` is NOT runtime-bindable — the engine resolves it at load time (vanilla only
		   ever sets it to a literal or a $variable, never a #binding). So it is a COMPILE-TIME
		   $variable; shadowed text arrives as its own element TYPE and the shadow_frame /
		   shadow_wrap_frame instantiations set $shadow: true. */
		"$shadow|default": false,
		"shadow": "$shadow",
		"text_alignment": "left",
		"size": [
			"default",
			"default"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"$payload_collection|default": "form_buttons",
		"$payload_binding|default": "#form_button_text",
		"$cell_details_binding_type|default": "none",
		"$details_collection|default": "",
		"$label_skip|default": "('%.1024s' * #payload)",
		/* WHERE THE FONT COMES FROM. #font_type is an engine-reserved target: the alias is
		   validated the moment it is written, and an unknown one logs "Could not find font
		   alias" to NonAssertErrorLog (a Marketplace blocker) — `binding_condition` cannot
		   suppress that, so the value has to be right for EVERY cell this label mounts on.
		   Sub-element labels (option rows, input value/placeholder) sit inside a payload
		   whose group slot 1 IS their own font, so they keep the default. The label-cell
		   leaves mount on every cell type — image, button, toggle — where the group's first
		   slot is a texture, so they read the COMMON [606-688] font slot instead.

		   INVARIANT: only override $font_source on a control whose #payload is a full
		   CONTROL BLOCK. Option blobs (#custom_radio_text / #dropdown_option_text) have no
		   reserved block — their byte 606 lands mid-`background`, so the common-slot
		   expression would feed a texture fragment straight back into #font_type. Today the
		   only overriders are the three label-cell leaves. */
		"$font_source|default": "(('%.82s' * #raw_label_font) - ('%.2s' * #raw_label_font) - ';')",
		"$text_source|default": "(('%.82s' * #raw_label_text) - ('%.2s' * #raw_label_text) - ';')",
		"$native_binding|default": "#form_button_text",
		"$native_target|default": "#label_native_unused",
		"bindings": [
			{
				/* fetch shape is the custom_dropdown-PROVEN one: collection binding FIRST,
				   details second with an EMPTY name (the toggle-proven form) — a details
				   binding NAMED custom_dropdown, placed first, hard-crashed the ore form. */
				"binding_name": "$payload_binding",
				"binding_type": "collection",
				"binding_condition": "always",
				"binding_collection_name": "$payload_collection",
				"binding_name_override": "#payload"
			},
			{
				"binding_type": "$cell_details_binding_type",
				"binding_collection_name": "$details_collection"
			},
			{
				/* optional native text channel (no-op by default) */
				"binding_name": "$native_binding",
				"binding_type": "collection",
				"binding_condition": "always",
				"binding_collection_name": "$payload_collection",
				"binding_name_override": "$native_target"
			},
			{
				/* label group, decoded sequentially from $label_skip.
				   All `visible`: skipped when the owning frame is gated off, run once when
				   visible (payload is screen-constant). Live text (modal option rows etc.)
				   rides the native channel above, NOT this decode. */
				"binding_type": "view",
				"source_property_name": "$label_skip",
				"target_property_name": "#skip_to_label",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#payload - #skip_to_label)",
				"target_property_name": "#label_rem0",
				"binding_condition": "visible"
			},
			{
				/* group slot 1 (v0008): the group's own font cell. Consumed here to keep the
				   sequential walk aligned; whether it REACHES #font_type is $font_source's
				   call (see above). */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem0)",
				"target_property_name": "#raw_label_font",
				"binding_condition": "visible"
			},
			{
				/* common font slot [606-688] — a valid alias on every component type */
				"binding_type": "view",
				"source_property_name": "('%.606s' * #payload)",
				"target_property_name": "#skip_to_common_font",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#payload - #skip_to_common_font)",
				"target_property_name": "#rem_at_common_font",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_at_common_font)",
				"target_property_name": "#raw_common_font",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "$font_source",
				"target_property_name": "#font_type",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem0 - #raw_label_font)",
				"target_property_name": "#label_rem1",
				"binding_condition": "visible"
			},
			{
				/* group slot 2: fontScaleFactor */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem1)",
				"target_property_name": "#raw_label_scale",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_label_scale) - ('%.2s' * #raw_label_scale) - ';')",
				"target_property_name": "#font_scale_factor",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem1 - #raw_label_scale)",
				"target_property_name": "#label_rem2",
				"binding_condition": "visible"
			},
			{
				/* group slot 3: x -> anchored X (needs the [1,1] host frame) */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem2)",
				"target_property_name": "#raw_label_x",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_label_x) - ('%.2s' * #raw_label_x) - ';') * 1)",
				"target_property_name": "#anchored_offset_value_x",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem2 - #raw_label_x)",
				"target_property_name": "#label_rem3",
				"binding_condition": "visible"
			},
			{
				/* group slot 4: y -> anchored Y */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem3)",
				"target_property_name": "#raw_label_y",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_label_y) - ('%.2s' * #raw_label_y) - ';') * 1)",
				"target_property_name": "#anchored_offset_value_y",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#label_rem3 - #raw_label_y)",
				"target_property_name": "#label_rem4",
				"binding_condition": "visible"
			},
			{
				/* group slot 5 (v0008): text. TERMINAL payloads (the Text cells) carry it
				   as an UNPADDED, UNPREFIXED, UNCAPPED tail: $text_source overrides to
				   `#label_rem4` and the raw cell candidate below goes inert. MID-PAYLOAD
				   groups (options, form-control labels, input value/placeholder) keep the
				   fixed 83-byte cell via the default. The tail is also where a client-side
				   RawMessage resolves to: the form text is sent as
				   { rawtext: [{ text: <fixed fields> }, { translate, with }] } and the
				   client concatenates the RESOLVED translation into exactly this region. */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #label_rem4)",
				"target_property_name": "#raw_label_text",
				"binding_condition": "visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "$text_source",
				"target_property_name": "#text",
				"binding_condition": "visible"
			}
		]
	}
}
