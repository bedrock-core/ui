{
	// The item renderer that hides the runtime's transport item.
	//
	// A button press auto-places its transport into the player's inventory, and
	// a grid would draw it there for the tick it takes the script to pull it
	// back. So a grid over the player's own items draws its cells with this
	// renderer instead: the item and its durability bar, wrapped in a panel that
	// reads the slot's item id and hides itself when it is the transport's —
	// the runtime's transport aux (12320768), a legacy-range block whose id never
	// shifts, whatever items other addons register.
	"namespace": "core_ui_chest",

	"gated_item": {
		"type": "panel",
		"size": [ "100%", "100%" ],
		"controls": [
			{ "renderer@core_ui_chest.item_renderer": { "size": [ "100%", "100%" ] } },
			{
				"durability@core_ui_chest.durability_bar": {
					"$durability_bar_required": true,
					"offset": [ 0, 5 ],
					"layer": 20
				}
			}
		],
		"bindings": [
			{ "binding_type": "collection_details", "binding_collection_name": "$item_collection_name" },
			{ "binding_name": "#item_id_aux", "binding_name_override": "#aux", "binding_type": "collection", "binding_collection_name": "$item_collection_name" },
			{ "binding_type": "view", "source_property_name": "(not (#aux = 12320768))", "target_property_name": "#visible" }
		]
	}
}
