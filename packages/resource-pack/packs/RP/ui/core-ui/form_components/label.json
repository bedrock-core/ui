{
	// Modal label router: renders the DECORATIVE elements (text / image / panel —
	// and everything composed from them, e.g. cards) inside a native ModalForm.
	// The TS side emits them through `form.label()` (the label slot works on both
	// backends); this router reuses the SAME merged label cell as the ActionForm's
	// core_ui_common.label_router, re-pointed at the modal payload via its
	// $payload_* parameters: collection custom_form, binding #custom_text, plus the
	// per-cell collection_details context every modal cell needs. Unlike the action
	// router, IMAGE stays here: modal images ride the label slot (the modal header
	// slot's payload channel is unproven), so the image component mounts as a
	// sibling variant. Buttons stay modal-forbidden (the TS restriction pass throws
	// before anything reaches here).
	"namespace": "core_ui_form_components",
	"label_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"controls": [
			{
				"cell@core_ui_components.label_cell": {
					"$payload_collection": "custom_form",
					"$payload_binding": "#custom_text",
					"$cell_details_binding_type": "collection_details"
				}
			},
			{
				"image@core_ui_components.image": {
					"$payload_collection": "custom_form",
					"$payload_binding": "#custom_text",
					"$cell_details_binding_type": "collection_details"
				}
			}
		]
	}
}
