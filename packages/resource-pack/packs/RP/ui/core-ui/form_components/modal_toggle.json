{
	"namespace": "core_ui_form_components",
	"toggle_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"controls": [
			{
				"toggle@core_ui_form_components.toggle": {}
			}
		]
	},
	"toggle": {
		"type": "panel",
		"size": [
			0,
			0
		],
		"layer": 50,
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#size_binding_x": 0.0,
			"#size_binding_y": 0.0,
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"visible": "#visible",
		"enabled": "#enabled", // TODO needs testing
		"$normalize": 1.0,
		"bindings": [
			{
				/* Establish the current cell's collection context so the #custom_text
				   collection binding below resolves to THIS cell's row (not row 0).
				   Without this every cell decodes the same row and all stack at origin. */
				"binding_type": "collection_details",
				"binding_collection_name": "custom_form"
			},
			{
				"binding_name": "#custom_text",
				"binding_type": "collection",
				"binding_collection_name": "custom_form"
			},
			{
				/* --- strip protocol header (9 chars) --- */
				"binding_type": "view", // protocol header size
				"source_property_name": "('%.9s' * #custom_text)",
				"target_property_name": "#protocol_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_text - #protocol_header)",
				"target_property_name": "#rem_after_header"
			},
			{
				/* --- type (string) - field 0 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.83s' * #rem_after_header)",
				"target_property_name": "#raw_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_header - #raw_type)",
				"target_property_name": "#rem_after_type"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width - padding_char (;)
				"source_property_name": "(('%.82s' * #raw_type) - ('%.2s' * #raw_type) - ';')",
				"target_property_name": "#type"
			},
			{
				/* --- width (int) - field 1 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.83s' * #rem_after_type)",
				"target_property_name": "#raw_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_type - #raw_width)",
				"target_property_name": "#rem_after_width"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width - padding_char (;)
				"source_property_name": "(('%.82s' * #raw_width) - ('%.2s' * #raw_width) - ';')",
				"target_property_name": "#size_binding_x"
			},
			{
				/* --- height (int) - field 2 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.83s' * #rem_after_width)",
				"target_property_name": "#raw_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_width - #raw_height)",
				"target_property_name": "#rem_after_height"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width - padding_char (;)
				"source_property_name": "(('%.82s' * #raw_height) - ('%.2s' * #raw_height) - ';')",
				"target_property_name": "#size_binding_y"
			},
			{
				/* --- x (int) - field 3 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.83s' * #rem_after_height)",
				"target_property_name": "#raw_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_height - #raw_x)",
				"target_property_name": "#rem_after_x"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width - padding_char (;)
				"source_property_name": "((('%.82s' * #raw_x) - ('%.2s' * #raw_x) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_x"
			},
			{
				/* --- y (float) - field 4 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.83s' * #rem_after_x)",
				"target_property_name": "#raw_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_x - #raw_y)",
				"target_property_name": "#rem_after_y"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width - padding_char (;)
				"source_property_name": "((('%.82s' * #raw_y) - ('%.2s' * #raw_y) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_y"
			},
			{
				/* --- visible (boolean) - field 5 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.8s' * #rem_after_y)",
				"target_property_name": "#raw_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_y - #raw_visible)",
				"target_property_name": "#rem_after_visible"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width (s:) - padding_char (;)
				"source_property_name": "(('%.7s' * #raw_visible) - ('%.2s' * #raw_visible) - ';')",
				"target_property_name": "#pre_visible"
			},
			{
				/* Per-type visibility gate: each control's decode panel runs for EVERY
				   collection cell, so it must self-hide unless THIS cell's encoded type
				   matches. #type decodes to the slot type (s: prefix stripped) =
				   'modal-toggle'. Without this every cell would render a toggle. */
				"binding_type": "view",
				"source_property_name": "(#pre_visible and (#type = 'modal-toggle'))",
				"target_property_name": "#visible"
			},
			{
				/* --- enabled (boolean) - field 6 --- */
				"binding_type": "view", // full_width
				"source_property_name": "('%.8s' * #rem_after_visible)",
				"target_property_name": "#raw_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_visible - #raw_enabled)",
				"target_property_name": "#rem_after_enabled"
			},
			{
				"binding_type": "view", // (full_width - marker_width) - prefix_width - padding_char (;)
				"source_property_name": "(('%.7s' * #raw_enabled) - ('%.2s' * #raw_enabled) - ';')",
				"target_property_name": "#enabled"
			},
			{
				/* --- skip __reserved (274) + commented (70) --- */
				"binding_type": "view", // reserved full_width
				"source_property_name": "('%.584s' * #rem_after_enabled)",
				"target_property_name": "#skip_reserved_control"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_enabled - #skip_reserved_control)",
				"target_property_name": "#serialized_data"
			}
		],
		"controls": [
			{
				"toggle@core_ui_form_components.toggle_control": {}
			}
		]
	},
	// Hardcoded rebuild of the vanilla server_form.custom_toggle interactive widget.
	// Flattened from the vanilla chain (option_toggle -> ... -> common.toggle ->
	// toggle_visuals) down to the irreducible interactive core, so this file pulls in
	// no vanilla/settings_common controls. Full 8 visual states, each a dedicated image
	// using the vanilla toggle textures (locked = base art at 0.5 alpha, matching
	// vanilla option_toggle_on_locked / option_toggle_off_locked).
	"toggle_control": {
		"type": "toggle",
		"size": [
			30,
			16
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 2,
		"enabled": "#enabled",
		"toggle_name": "custom_toggle",
		// Native write-back hook: tells the engine this toggle belongs to the custom_form
		// collection, so a click writes the new state to the CURRENT cell's row (via the
		// active collection index) instead of row 0. This is a real `type:"toggle"`
		// property in vanilla common.toggle ("toggle_grid_collection_name"), NOT a binding —
		// without it the write-back has no collection to index and collapses to row 0.
		"toggle_grid_collection_name": "custom_form",
		"toggle_default_state": false,
		"toggle_group_forced_index": -1,
		"toggle_group_default_selected": 0,
		"radio_toggle_group": false,
		"enable_directional_toggling": false,
		"sound_name": "random.click",
		"sound_volume": 1.0,
		"sound_pitch": 1.0,
		"focus_enabled": true,
		"focus_magnet_enabled": true,
		"default_focus_precedence": 0,
		"checked_control": "checked",
		"unchecked_control": "unchecked",
		"checked_hover_control": "checked_hover",
		"unchecked_hover_control": "unchecked_hover",
		"checked_locked_control": "checked_locked",
		"unchecked_locked_control": "unchecked_locked",
		"checked_locked_hover_control": "checked_locked_hover",
		"unchecked_locked_hover_control": "unchecked_locked_hover",
		"property_bag": {
			"#toggle_state": true
		},
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.menu_select",
				"mapping_type": "pressed"
			},
			{
				"from_button_id": "button.menu_ok",
				"to_button_id": "button.menu_ok",
				"mapping_type": "focused"
			}
		],
		/* State/enabled bindings live on the toggle CHILD; the per-cell collection
		   context (collection_details) is established by the PARENT `toggle` panel.
		   Vanilla splits these the same way — the real toggle is "done as a child to
		   allow for parent bindings" (ui_template_toggles.json light_ui_toggle_collection).
		   Putting collection_details on the SAME control as the state binding routes the
		   click WRITE-back to row 0 (clicking any cell flips the first). */
		"bindings": [
			{
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_toggle_state",
				"binding_name_override": "#toggle_state"
			},
			{
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_toggle_enabled",
				"binding_name_override": "#enabled"
			}
		],
		"controls": [
			{
				"checked": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_on"
				}
			},
			{
				"unchecked": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_off"
				}
			},
			{
				"checked_hover": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_on_hover"
				}
			},
			{
				"unchecked_hover": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_off_hover"
				}
			},
			{
				"checked_locked": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_on",
					"alpha": 0.5
				}
			},
			{
				"unchecked_locked": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_off",
					"alpha": 0.5
				}
			},
			{
				"checked_locked_hover": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_on",
					"alpha": 0.5
				}
			},
			{
				"unchecked_locked_hover": {
					"type": "image",
					"size": [ 30, 16 ],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"texture": "textures/ui/toggle_off",
					"alpha": 0.5
				}
			}
		]
	}
}