{
	"namespace": "core_ui_form_components",
	"toggle_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"controls": [
			{
				"toggle@core_ui_form_components.toggle": {}
			}
		]
	},
	"toggle@core_ui_common.control": {
		// Extends the shared base (core_ui_common.control): the base owns the whole generic
		// control-block decode; this modal cell just points it at the modal payload
		// (custom_form / #custom_text / per-cell collection_details) and supplies its type
		// gate. The base additionally decodes #background + #region and gates on
		// $region_filter (default 0) — modal cells always encode region 0, so the region
		// gate passes; the bg decode is unused here (harmless). (The old root also
		// produced #serialized_data — dead: nothing on the root consumed it; the control
		// children self-decode their own fields.)
		"layer": 50,
		"$payload_collection": "custom_form",
		"$payload_binding": "#custom_text",
		"$cell_details_binding_type": "collection_details",
		"$type_gate": "(#pre_visible and (#type = 'modal-toggle'))",
		"controls": [
			{
				"toggle@core_ui_form_components.toggle_control": {}
			}
		]
	},
	"toggle_control": {
		"type": "toggle",
		"size": [
			"100%",
			"100%"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 2,
		"enabled": "#enabled",
		"toggle_name": "custom_toggle",
		// Native write-back hook: tells the engine this toggle belongs to the custom_form
		// collection, so a click writes the new state to the CURRENT cell's row (via the
		// active collection index) instead of row 0. This is a real `type:"toggle"`
		// property in vanilla common.toggle ("toggle_grid_collection_name"), NOT a binding —
		// without it the write-back has no collection to index and collapses to row 0.
		"toggle_grid_collection_name": "custom_form",
		"toggle_default_state": false,
		"toggle_group_forced_index": -1,
		"toggle_group_default_selected": 0,
		"enable_directional_toggling": false,
		"sound_name": "random.click",
		"sound_volume": 1.0,
		"sound_pitch": 1.0,
		"focus_enabled": true,
		"focus_magnet_enabled": true,
		"default_focus_precedence": 0,
		"checked_control": "checked",
		"unchecked_control": "unchecked",
		"checked_hover_control": "checked_hover",
		"unchecked_hover_control": "unchecked_hover",
		"checked_locked_control": "checked_locked",
		"unchecked_locked_control": "unchecked_locked",
		"checked_locked_hover_control": "checked_locked_hover",
		"unchecked_locked_hover_control": "unchecked_locked_hover",
		"property_bag": {
			"#toggle_state": true
		},
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.menu_select",
				"mapping_type": "pressed"
			},
			{
				"from_button_id": "button.menu_ok",
				"to_button_id": "button.menu_ok",
				"mapping_type": "focused"
			}
		],
		/* State/enabled bindings live on the toggle CHILD; the per-cell collection
		   context (collection_details) is established by the PARENT `toggle` panel.
		   Vanilla splits these the same way — the real toggle is "done as a child to
		   allow for parent bindings" (ui_template_toggles.json light_ui_toggle_collection).
		   Putting collection_details on the SAME control as the state binding routes the
		   click WRITE-back to row 0 (clicking any cell flips the first). */
		"bindings": [
			{
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_toggle_state",
				"binding_name_override": "#toggle_state"
			},
			{
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_toggle_enabled",
				"binding_name_override": "#enabled"
			}
		],
		// State faces: shared core_ui_common.modal_state_face (custom_form payload).
		// Offsets: unchecked(background)[440], uncheckedHover[1024], uncheckedLocked[1190],
		// checked[1273], checkedHover[1356], checkedLocked[1439]; locked_hover reuses locked.
		"controls": [
			{
				"checked@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1273s' * #payload)"
				}
			},
			{
				"unchecked@core_ui_common.modal_state_face": {
					"$face_skip": "('%.440s' * #payload)"
				}
			},
			{
				"checked_hover@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1356s' * #payload)"
				}
			},
			{
				"unchecked_hover@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1024s' * #payload)"
				}
			},
			{
				"checked_locked@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1439s' * #payload)"
				}
			},
			{
				"unchecked_locked@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1190s' * #payload)"
				}
			},
			{
				"checked_locked_hover@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1439s' * #payload)"
				}
			},
			{
				"unchecked_locked_hover@core_ui_common.modal_state_face": {
					"$face_skip": "('%.1190s' * #payload)"
				}
			}
		]
	}
}