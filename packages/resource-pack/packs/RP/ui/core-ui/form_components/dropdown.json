							"source_property_name": "(#custom_radio_text - #skip_to_opt_bg)",
							"target_property_name": "#rem_at_opt_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_opt_bg)",
							"target_property_name": "#raw_opt_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_opt_bg) - ('%.2s' * #raw_opt_bg) - ';')",
							"target_property_name": "#texture"
						},
						{
							"binding_type": "view",
							"source_property_name": "(not (#texture = ''))",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	},
	"dropdown_custom": {
		"type": "panel",
		"$dropdown_name|default": "dropdown_control",
		"$dropdown_scroll_content_size|default": [
			"100%",
			"500%"
		],
		"controls": [
			{
				"$dropdown_name@$dropdown_toggle": {
					"type": "dropdown",
					"$toggle_view_binding_name": "$dropdown_name",
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"dropdown_name": "$dropdown_name",
					"dropdown_content_control": "dropdown_content",
					"dropdown_area": "$dropdown_area",
					"$toggle_name": "$dropdown_name",
					"$toggle_state_binding_name": "('#' + $dropdown_name)"
				}
			},
			{
				"dropdown_content": {
					"type": "input_panel",
					// we really want this on top of everything: the form's component rows
					// (decode panels) sit at layer 50+, so 42 sorted the popup BEHIND the
					// form scroll content. 200 clears everything on the modal screen.
					"layer": 200,
					"size": "$dropdown_scroll_content_size",
					// GEOMETRY: the engine pins this box's placement itself (dropdown_area
					// lookup fails in our screen — no control named "inside_header_panel" —
					// so the box's TOP edge lands at the screen's vertical middle, same for
					// every dropdown; the box's own anchors AND offset are IGNORED there,
					// probe-verified). We treat that pinned top edge as a stable reference
					// line and position the ACTUAL popup (popup_card below) relative to it.
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"modal": true,
					"property_bag": {
						"#is_dropdown": true
					},
					"controls": [
						{
							// The real popup surface: hangs on the box's pinned top edge
							// (= screen middle) and shifts up by HALF its own height, so it
							// renders centered on the middle line (50% up / 50% down).
							// Upward overflow past the box is NOT clipped (in-game verified).
							// #size_binding values scale by the PARENT size, so the card must
							// sit inside a [1,1] panel to map 1:1 to pixels (the router
							// pattern; without it the 60px height rendered as 60×48=2880).
							// Width therefore ALSO decodes from the payload (control width,
							// field 1 [92]); height decodes from popupHeight [1605] (TS:
							// items×17px + 9px chrome, capped at 105px), and the centering
							// offset is derived from it (-height/2) via anchored offset.
							"popup_anchor": {
								"type": "panel",
								"size": [
									1,
									1
								],
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"controls": [
									{
										// CENTERING with PROVEN mechanics only (fractional string multiplies and
										// formula-on-formula both silently yield 0 — probe-verified: decode text showed
										// "n:105" while the bound height stayed 0). popup_shift decodes width [92] and
										// popupHeight [1605] with plain "* 1" (the verified pattern) inside the [1,1]
										// anchor, becoming a w×h px panel hanging DOWN from the box's pinned top edge
										// (= screen middle). popup_card is pure statics: 100%×100% of the shift, with
										// its BOTTOM anchored to the shift's vertical MIDDLE (bottom_left→left_middle),
										// so it spans exactly h/2 above and h/2 below the middle line. No offsets, no
										// arithmetic beyond the proven coercion.
										"popup_shift": {
											"type": "panel",
											"size": [
												1,
												0
											],
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"property_bag": {
												"#size_binding_x": 0.0,
												"#size_binding_y": 0.0
											},
											"bindings": [
												{
													"binding_name": "#custom_text",
													"binding_type": "collection",
													"binding_collection_name": "custom_form"
												},
												{
													/* --- width from the control block (field 1, [92]); parent is the [1,1]
   anchor so the value maps 1:1 to px --- */
													"binding_type": "view",
													"source_property_name": "('%.92s' * #custom_text)",
													"target_property_name": "#skip_to_popup_w"
												},
												{
													"binding_type": "view",
													"source_property_name": "(#custom_text - #skip_to_popup_w)",
													"target_property_name": "#rem_at_popup_w"
												},
												{
													"binding_type": "view",
													"source_property_name": "('%.83s' * #rem_at_popup_w)",
													"target_property_name": "#raw_popup_w"
												},
												{
													"binding_type": "view",
													"source_property_name": "((('%.82s' * #raw_popup_w) - ('%.2s' * #raw_popup_w) - ';') * 1)",
													"target_property_name": "#size_binding_x"
												},
												{
													/* --- FULL popupHeight [1605], proven "* 1" coercion; the halving is done
   														geometrically by popup_card's bottom_left→left_middle anchoring --- */
													"binding_type": "view",
													"source_property_name": "('%.1356s' * #custom_text)",
													"target_property_name": "#skip_to_popup_h"
												},
												{
													"binding_type": "view",
													"source_property_name": "(#custom_text - #skip_to_popup_h)",
													"target_property_name": "#rem_at_popup_h"
												},
												{
													"binding_type": "view",
													"source_property_name": "('%.83s' * #rem_at_popup_h)",
													"target_property_name": "#raw_popup_h"
												},
												{
													"binding_type": "view",
													"source_property_name": "((('%.82s' * #raw_popup_h) - ('%.2s' * #raw_popup_h) - ';') * 1)",
													"target_property_name": "#size_binding_y"
												}
											],
											"controls": [
												{
													"popup_card": {
														"type": "panel",
														"size": [
															"100%",
															"100%"
														],
														"anchor_from": "bottom_left",
														"anchor_to": "left_middle",
														"controls": [
															{
																"scroll@common.scrolling_panel": {
																	"layer": 2,
																	"$allow_scrolling_even_when_content_fits": false,
																	"size": [
																		"100%",
																		"100%"
																	],
																	"$scrolling_pane_size": [
																		"100%",
																		"100%"
																	],
																	"$scrolling_content": "$dropdown_content",
																	"$scroll_view_port_size": [
																		"100% - 4px",
																		"100% - 4px"
																	],
																	"$scroll_view_port_size_touch": [
																		"100% - 4px",
																		"100% - 4px"
																	],
																	"$scroll_view_port_offset": [
																		2,
																		2
																	],
																	"$scroll_view_port_offset_touch": [
																		2,
																		2
																	],
																	"$scroll_size": [
																		5,
																		"100%-2px"
																	],
																	"$scroll_size_touch": [
																		5,
																		"100%-2px"
																	],
																	"$scroll_background_image_control": "core_ui_form_components.dropdown_popup_background",
																	"$background_size": [
																		"100%",
																		"100%"
																	],
																	"$background_size_touch": [
																		"100%",
																		"100%"
																	],
																	"$show_background": true,
																	"$scroll_bar_contained": true,
																	"$scroll_bar_contained_touch": true
																}
															}
														]
													}
												}
											]
										}
									}
								]
							}
						}
					],
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "($dropdown_name)",
							"source_property_name": "#toggle_state",
							"target_property_name": "#visible",
							"resolve_sibling_scope": true
						}
					],
					"button_mappings": [
						{
							"from_button_id": "button.menu_cancel",
							"to_button_id": "button.dropdown_exit",
							"mapping_type": "global"
						},
						{
							"from_button_id": "button.menu_ok",
							"to_button_id": "button.dropdown_exit",
							"mapping_type": "global"
						},
						{
							"from_button_id": "button.menu_select",
							"to_button_id": "button.dropdown_exit",
							"mapping_type": "global"
						},
						{
							"from_button_id": "button.menu_up",
							"to_button_id": "button.menu_up",
							"mapping_type": "global",
							"scope": "view"
						},
						{
							"from_button_id": "button.menu_down",
							"to_button_id": "button.menu_down",
							"mapping_type": "global",
							"scope": "view"
						},
						{
							"from_button_id": "button.menu_left",
							"to_button_id": "button.menu_left",
							"mapping_type": "global",
							"scope": "view"
						},
						{
							"from_button_id": "button.menu_right",
							"to_button_id": "button.menu_right",
							"mapping_type": "global",
							"scope": "view"
						}
					]
				}
			}
		]
	}
}
