{
	// yeah do not ask me how this one works, ask about the rest --drav0011
	"namespace": "core_ui_form_components",
	// --- copied from common.toggle (ui_common.json:366-557) ---
	// Still extends vanilla common.toggle_visuals for now.
	// TTS and focus properties/bindings stripped out (nuked for now).
	// Only the variables that downstream consumers actually override are kept as
	// $vars: $toggle_binding_type / $toggle_grid_collection_name (dropdown_control),
	// $toggle_name / $toggle_state_binding_name (set at instantiation). Everything
	// else was single-valued and has been hardcoded.
	"vanilla_toggle": {
		"type": "toggle",
		// the 8 state children (was common.toggle_visuals, inlined — single use)
		"controls": [
			{
				"unchecked@$unchecked_control": {}
			},
			{
				"checked@$checked_control": {}
			},
			{
				"unchecked_hover@$unchecked_hover_control": {}
			},
			{
				"checked_hover@$checked_hover_control": {}
			},
			{
				"unchecked_locked@$unchecked_locked_control": {}
			},
			{
				"checked_locked@$checked_locked_control": {}
			},
			{
				"unchecked_locked_hover@$unchecked_locked_hover_control": {}
			},
			{
				"checked_locked_hover@$checked_locked_hover_control": {}
			}
		],
		"layer": 1,
		"sound_name": "random.click",
		"sound_volume": 1.0,
		"sound_pitch": 1.0,
		"checked_control": "checked",
		"unchecked_control": "unchecked",
		"checked_hover_control": "checked_hover",
		"unchecked_hover_control": "unchecked_hover",
		"checked_locked_control": "checked_locked",
		"unchecked_locked_control": "unchecked_locked",
		"checked_locked_hover_control": "checked_locked_hover",
		"unchecked_locked_hover_control": "unchecked_locked_hover",
		"$toggle_binding_type|default": "global",
		"$toggle_state_binding_name|default": "#toggle_state",
		"$toggle_grid_collection_name|default": "",
		// radio_toggle_group MUST stay a $var: option-row toggles override it to
		// true. Hardcoding it to false made the option-list radios instantiate as
		// non-radio toggles inside a radio-group factory, which hard-crashes the game
		// (no log) on screen open. The toggle_group_* fields ride along with it.
		"$radio_toggle_group|default": false,
		"$toggle_group_forced_index|default": -1,
		"$toggle_group_default_selected|default": 0,
		"radio_toggle_group": "$radio_toggle_group",
		"toggle_name": "$toggle_name",
		"toggle_default_state": false,
		"toggle_group_forced_index": "$toggle_group_forced_index",
		"toggle_group_default_selected": "$toggle_group_default_selected",
		"toggle_grid_collection_name": "$toggle_grid_collection_name",
		"enable_directional_toggling": false,
		"toggle_on_button": "toggle.toggle_on",
		"toggle_off_button": "toggle.toggle_off",
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "button.menu_select",
				"mapping_type": "pressed"
			},
			{
				"from_button_id": "button.menu_ok",
				"to_button_id": "button.menu_ok",
				"mapping_type": "focused"
			},
			{
				"from_button_id": "button.controller_back",
				"to_button_id": "button.controller_back",
				"mapping_type": "focused",
				"ignored": true
			}
		],
		"property_bag": {
			"#toggle_state": true
		},
		"bindings": [
			{
				"binding_type": "$toggle_binding_type",
				"binding_condition": "visible",
				"binding_collection_name": "$toggle_grid_collection_name",
				"binding_name": "$toggle_state_binding_name",
				"binding_name_override": "#toggle_state"
			},
			{
				"binding_type": "none",
				"binding_condition": "visible",
				"binding_collection_name": "$toggle_grid_collection_name",
				"binding_name": "#toggle_enabled",
				"binding_name_override": "#enabled"
			},
			{
				"binding_type": "none",
				"binding_collection_name": ""
			}
		]
	},
	// --- copied from settings_common.option_radio_dropdown_group (settings_common.json:1723-1741) ---
	// Inner radio_control_group still extends vanilla settings_common.
	"vanilla_option_radio_dropdown_group": {
		"type": "panel",
		"size": [
			"100% - 4px",
			"100%c + 4px"
		],
		"offset": [
			2,
			1
		],
		"controls": [
			{
				// was vanilla_option_radio_group_control (settings_common.option_radio_group_control), inlined — single use
				"radio_control_group": {
					"type": "stack_panel",
					"size": [
						"100%",
						"100%c"
					],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"controls": "$radio_buttons",
					"$radio_factory|default": {
						"name": "empty"
					},
					"$radio_collection_name|default": "",
					"$radio_bindings|default": [],
					"factory": "$radio_factory",
					"collection_name": "$radio_collection_name",
					"bindings": "$radio_bindings"
				}
			}
		]
	},
	"dropdown_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"controls": [
			{
				"dropdown@core_ui_form_components.dropdown": {}
			}
		]
	},
	"dropdown": {
		"type": "panel",
		"size": [
			0,
			0
		],
		"layer": 50,
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#size_binding_x": 0.0,
			"#size_binding_y": 0.0,
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"visible": "#visible",
		"enabled": "#enabled",
		"$normalize": 1.0,
		"bindings": [
			{
				/* Per-cell collection context so #custom_text resolves to THIS row. */
				"binding_type": "collection_details",
				"binding_collection_name": "custom_form"
			},
			{
				"binding_name": "#custom_text",
				"binding_type": "collection",
				"binding_collection_name": "custom_form"
			},
			{
				/* --- strip protocol header (9 chars) --- */
				"binding_type": "view",
				"source_property_name": "('%.9s' * #custom_text)",
				"target_property_name": "#protocol_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_text - #protocol_header)",
				"target_property_name": "#rem_after_header"
			},
			{
				/* --- type (string) - field 0 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_header)",
				"target_property_name": "#raw_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_header - #raw_type)",
				"target_property_name": "#rem_after_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_type) - ('%.2s' * #raw_type) - ';')",
				"target_property_name": "#type"
			},
			{
				/* --- width (int) - field 1 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_type)",
				"target_property_name": "#raw_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_type - #raw_width)",
				"target_property_name": "#rem_after_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_width) - ('%.2s' * #raw_width) - ';')",
				"target_property_name": "#size_binding_x"
			},
			{
				/* --- height (int) - field 2 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_width)",
				"target_property_name": "#raw_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_width - #raw_height)",
				"target_property_name": "#rem_after_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_height) - ('%.2s' * #raw_height) - ';')",
				"target_property_name": "#size_binding_y"
			},
			{
				/* --- x (int) - field 3 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_height)",
				"target_property_name": "#raw_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_height - #raw_x)",
				"target_property_name": "#rem_after_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_x) - ('%.2s' * #raw_x) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_x"
			},
			{
				/* --- y (float) - field 4 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_x)",
				"target_property_name": "#raw_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_x - #raw_y)",
				"target_property_name": "#rem_after_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_y) - ('%.2s' * #raw_y) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_y"
			},
			{
				/* --- visible (boolean) - field 5 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_y)",
				"target_property_name": "#raw_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_y - #raw_visible)",
				"target_property_name": "#rem_after_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_visible) - ('%.2s' * #raw_visible) - ';')",
				"target_property_name": "#pre_visible"
			},
			{
				/* --- enabled (boolean) - field 6 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_visible)",
				"target_property_name": "#raw_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_visible - #raw_enabled)",
				"target_property_name": "#rem_after_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_enabled) - ('%.2s' * #raw_enabled) - ';')",
				"target_property_name": "#enabled"
			},
			{
				/* Per-type visibility gate: only render the dropdown on dropdown cells. */
				"binding_type": "view",
				"source_property_name": "(#pre_visible and (#type = 'modal-dropdown'))",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				/* common.dropdown is self-contained: it instantiates BOTH the closed-box
				   toggle AND the popup (dropdown_content) as its own two children. */
				"dropdown_control@core_ui_form_components.dropdown_control": {}
			}
		]
	},
	// REWRITTEN to extend vanilla's PROVEN dropdown machinery instead of hand-flattening
	// it: the hand-built version froze the game on open (a button_mapping conflict
	// between the closed box and the popup that vanilla's own wiring doesn't have).
	// `dropdown_control` extends `common.dropdown` (ui_common.json:1103-1130) — its
	// closed-box toggle, button_mappings, focus/modal handling come from vanilla
	// verbatim via $dropdown_toggle, instead of being reconstructed by hand. We only
	// override the collection-binding variables, mirroring server_form.custom_dropdown's
	// own overrides (server_form.json:434-456) exactly, so write-back uses the SAME
	// vanilla-proven path the real settings dropdown uses, just pointed at our
	// custom_form/custom_dropdown collections instead of vanilla's settings ones.
	"dropdown_control@core_ui_form_components.dropdown_custom": {
		"size": [
			"100%",
			"100%"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 2,
		// $enabled / $option_enabled_binding_name normally come from the option_generic
		// wrapper (settings_common.json:190,229) that vanilla's full option_dropdown row
		// sits inside; we skip that wrapper (no settings-row label/layout), so supply
		// them directly.
		"$enabled": true,
		"$option_enabled_binding_name": "",
		"$dropdown_name": "custom_dropdown",
		// STEP 1 (custom backgrounds): closed box is now OUR OWN minimal control
		// (core_ui_form_components.dropdown_closed_box), not vanilla's
		// options_dropdown_toggle_control. type:"dropdown" (set below common.dropdown's
		// own instantiation, ui_common.json:1116) still owns ALL the native interactive
		// machinery (open/close, button_mappings, focus) — that's what avoided the
		// freeze last time — we only swap the VISUAL children it wraps.
		"$dropdown_toggle": "core_ui_form_components.dropdown_closed_box",
		"$dropdown_content": "core_ui_form_components.dropdown_options",
		"$dropdown_area": "inside_header_panel",
		// Tall box: the engine pins the box's TOP at the screen middle and it only
		// grows DOWNWARD; 1000% of the button (~240px) covers the popup card's full
		// lower half on any list (input region + render safety). The card itself is
		// sized/centered independently (popup_shift/popup_card).
		"$dropdown_scroll_content_size": [
			"100%",
			"1000%"
		],
		"$toggle_binding_type": "collection",
		"$toggle_grid_collection_name": "custom_form"
	},
	// Our own closed-box visuals, replacing vanilla's options_dropdown_toggle_control.
	// EXTENDS common.toggle (ui_common.json:366-557) — the SAME proven ancestor our
	// hand-built toggle_control (modal_toggle.json) uses — so it inherits
	// button_mappings/focus_enabled/sound_name etc. for free. common.dropdown's own
	// instantiation still overrides `type` to "dropdown" (ui_common.json:1116), which is
	// the actual native engine type that owns open/close; extending common.toggle here
	// is ONLY to pick up its non-visual properties, not to make this a real toggle.
	// (A bare type:"panel" version showed correct hover visuals but never registered
	// clicks — turned out `type:"dropdown"` still needs the toggle-family
	// button_mappings/focus properties, which only common.toggle's own ancestry
	// supplies; overriding just `checked_control`/`unchecked_control` as literal
	// properties bypassed the $variable-driven child generation those need too.)
	// #dropdown_option_text is set natively by the engine (the currently selected
	// option's text) — no collection binding needed here, unlike our other controls.
	"dropdown_closed_box@core_ui_form_components.vanilla_toggle": {
		"size": [
			"100%",
			"100%"
		],
		// Step 2: each toggle state maps to a decoded texture prop. idle→#background,
		// hover→#background_hover, open (checked)→#background_pressed, any locked→
		// #background_locked. Empty props fall back to #background in the face below.
		"$unchecked_control": "core_ui_form_components.dropdown_closed_box_face_default",
		"$unchecked_hover_control": "core_ui_form_components.dropdown_closed_box_face_hover",
		"$checked_control": "core_ui_form_components.dropdown_closed_box_face_pressed",
		"$checked_hover_control": "core_ui_form_components.dropdown_closed_box_face_pressed",
		"$unchecked_locked_control": "core_ui_form_components.dropdown_closed_box_face_locked",
		"$checked_locked_control": "core_ui_form_components.dropdown_closed_box_face_locked",
		"$unchecked_locked_hover_control": "core_ui_form_components.dropdown_closed_box_face_locked",
		"$checked_locked_hover_control": "core_ui_form_components.dropdown_closed_box_face_locked"
	},
	// Per-state faces: LITERAL copies of the normal button's state blocks
	// (core_ui_components.button, components/button.json:302-545). Each state's bg image
	// self-decodes its texture from the collection string at the same absolute offsets
	// as the button — the TS side emits the dropdown's state textures at button-identical
	// offsets ([1024-1272], right after the reserved block). The ONLY differences from
	// the button blocks are the collection binding (custom_form / #custom_text instead
	// of form_buttons / #form_button_text). No @extends, no $vars — copied whole, per
	// the working button pattern.
	"dropdown_closed_box_face_default": {
		"type": "panel",
		"size": [
			"100%",
			"100%"
		],
		"anchor_to": "center",
		"anchor_from": "center",
		"controls": [
			{
				"bg": {
					"type": "image",
					"size": [
						"100%",
						"100%"
					],
					"offset": [
						0,
						0
					],
					"fill": false,
					"anchor_to": "center",
					"anchor_from": "center",
					"texture": "#texture",
					"visible": "#visible",
					"alpha": 1,
					"bindings": [
						{
							/* decode background[440] directly */
							"binding_name": "#custom_text",
							"binding_type": "collection",
							"binding_collection_name": "custom_form"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.440s' * #custom_text)",
							"target_property_name": "#skip_to_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "(#custom_text - #skip_to_bg)",
							"target_property_name": "#rem_at_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "('%.83s' * #rem_at_bg)",
							"target_property_name": "#raw_bg"
						},
						{
							"binding_type": "view",
							"source_property_name": "(('%.82s' * #raw_bg) - ('%.2s' * #raw_bg) - ';')",
							"target_property_name": "#texture"
						},
						{
							"binding_type": "view",
							"source_property_name": "(not (#texture = ''))",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	},
	"dropdown_closed_box_face_hover": {
		"type": "panel",
		"size": [
			"100%",
			"100%"
		],
		"anchor_to": "center",
		"anchor_from": "center",
		"controls": [
			{
				"bg": {
