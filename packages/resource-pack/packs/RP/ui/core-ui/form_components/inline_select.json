	// Bullet glyph, DYNAMICALLY sized from the option blob: bulletWidth [1254] and
	// bulletHeight [1337] (appended after the geometry block, so no earlier offset moves).
	// Three-level structure per the [1,1] rule: a 1px frame (so the box's #size_binding_*
	// map 1:1 to px — same as inline_option_row), a box the decode sizes, and the image
	// filling it. The frame pins the bullet to the row's left-middle, like the old
	// hardcoded 12×12 image did.
	"inline_bullet_default": {
		"type": "panel",
		"size": [
			1,
			1
		],
		"anchor_from": "left_middle",
		"anchor_to": "left_middle",
		"layer": 11,
