			},
			{
				"binding_type": "view",
				"source_property_name": "('%.1254s' * #custom_radio_text)",
				"target_property_name": "#skip_bullet_w"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_radio_text - #skip_bullet_w)",
				"target_property_name": "#rem_bullet_w"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_bullet_w)",
				"target_property_name": "#raw_bullet_w"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_bullet_w) - ('%.2s' * #raw_bullet_w) - ';') * 1)",
				"target_property_name": "#size_binding_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.1337s' * #custom_radio_text)",
				"target_property_name": "#skip_bullet_h"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_radio_text - #skip_bullet_h)",
				"target_property_name": "#rem_bullet_h"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_bullet_h)",
				"target_property_name": "#raw_bullet_h"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_bullet_h) - ('%.2s' * #raw_bullet_h) - ';') * 1)",
				"target_property_name": "#size_binding_y"
			}
		],
		"controls": [
			{
				"img@$bullet_img": {}
			}
		]
	},
	// One shared bullet glyph image: texture from the option blob at $bullet_skip
	// (unselected [756] / selected [839]), shown per $bullet_visible (toggle-state
	// polarity; empty texture always hides). Both state variants are thin derivations —
	// the bullet_box $bullet_img name var picks one.
	"inline_bullet_img": {
		"type": "image",
		"size": [
			"100%",
			"100%"
		],
		"$bullet_skip|default": "('%.756s' * #custom_radio_text)",
		"$bullet_visible|default": "((not (#texture = '')) and (not #toggle_state))",
		"texture": "#texture",
		"visible": "#visible",
		"bindings": [
			{
				"binding_name": "#custom_radio_text",
				"binding_type": "collection",
				"binding_condition": "always",
				"binding_collection_name": "custom_dropdown"
			},
			{
				"binding_type": "collection_details"
			},
			{
				"binding_type": "view",
				"source_property_name": "$bullet_skip",
				"target_property_name": "#skip_texture"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_radio_text - #skip_texture)",
				"target_property_name": "#rem_texture"
			},
			{
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_texture)",
				"target_property_name": "#raw_texture"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_texture) - ('%.2s' * #raw_texture) - ';')",
				"target_property_name": "#texture"
			},
			{
				"binding_type": "collection",
				"binding_collection_name": "custom_dropdown",
				"binding_name": "#custom_radio_toggled",
				"binding_name_override": "#toggle_state"
			},
			{
				"binding_type": "view",
				"source_property_name": "$bullet_visible",
				"target_property_name": "#visible"
			}
		]
	},
	"inline_bullet_img_default@core_ui_form_components.inline_bullet_img": {
		"$bullet_skip": "('%.756s' * #custom_radio_text)",
		"$bullet_visible": "((not (#texture = '')) and (not #toggle_state))"
	},
	"inline_bullet_img_selected@core_ui_form_components.inline_bullet_img": {
		"$bullet_skip": "('%.839s' * #custom_radio_text)",
		"$bullet_visible": "((not (#texture = '')) and #toggle_state)"
	}
}
