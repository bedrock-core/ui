{
	"namespace": "core_ui_form_components",
	"input_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"controls": [
			{
				"input@core_ui_form_components.input": {}
			}
		]
	},
	"input": {
		"type": "panel",
		"size": [
			0,
			0
		],
		"layer": 50,
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#size_binding_x": 0.0,
			"#size_binding_y": 0.0,
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"visible": "#visible",
		"enabled": "#enabled",
		"$normalize": 1.0,
		"bindings": [
			{
				/* Per-cell collection context so #custom_text resolves to THIS row. */
				"binding_type": "collection_details",
				"binding_collection_name": "custom_form"
			},
			{
				"binding_name": "#custom_text",
				"binding_type": "collection",
				"binding_collection_name": "custom_form"
			},
			{
				/* --- strip protocol header (9 chars) --- */
				"binding_type": "view",
				"source_property_name": "('%.9s' * #custom_text)",
				"target_property_name": "#protocol_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_text - #protocol_header)",
				"target_property_name": "#rem_after_header"
			},
			{
				/* --- type (string) - field 0 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_header)",
				"target_property_name": "#raw_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_header - #raw_type)",
				"target_property_name": "#rem_after_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_type) - ('%.2s' * #raw_type) - ';')",
				"target_property_name": "#type"
			},
			{
				/* --- width (int) - field 1 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_type)",
				"target_property_name": "#raw_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_type - #raw_width)",
				"target_property_name": "#rem_after_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_width) - ('%.2s' * #raw_width) - ';')",
				"target_property_name": "#size_binding_x"
			},
			{
				/* --- height (int) - field 2 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_width)",
				"target_property_name": "#raw_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_width - #raw_height)",
				"target_property_name": "#rem_after_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_height) - ('%.2s' * #raw_height) - ';')",
				"target_property_name": "#size_binding_y"
			},
			{
				/* --- x (int) - field 3 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_height)",
				"target_property_name": "#raw_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_height - #raw_x)",
				"target_property_name": "#rem_after_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_x) - ('%.2s' * #raw_x) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_x"
			},
			{
				/* --- y (float) - field 4 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_x)",
				"target_property_name": "#raw_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_x - #raw_y)",
				"target_property_name": "#rem_after_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_y) - ('%.2s' * #raw_y) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_y"
			},
			{
				/* --- visible (boolean) - field 5 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_y)",
				"target_property_name": "#raw_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_y - #raw_visible)",
				"target_property_name": "#rem_after_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_visible) - ('%.2s' * #raw_visible) - ';')",
				"target_property_name": "#pre_visible"
			},
			{
				/* --- enabled (boolean) - field 6 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_visible)",
				"target_property_name": "#raw_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_visible - #raw_enabled)",
				"target_property_name": "#rem_after_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_enabled) - ('%.2s' * #raw_enabled) - ';')",
				"target_property_name": "#enabled"
			},
			{
				/* Per-type visibility gate: only render the edit box on input cells. */
				"binding_type": "view",
				"source_property_name": "(#pre_visible and (#type = 'modal-input'))",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"input@core_ui_form_components.input_control": {}
			}
		]
	},
	// Textureless native text field, flattened from vanilla common.text_edit_box.
	// READ: #custom_input_text (content) / #custom_placeholder_text / #custom_input_enabled,
	// all collection bindings on custom_form. WRITE-BACK: the engine writes the typed text
	// to the current row via text_edit_box_grid_collection_name:"custom_form" (the edit_box
	// analogue of the toggle's toggle_grid_collection_name).
	"input_control": {
		"type": "edit_box",
		"size": [
			"100%",
			"100%"
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 2,
		"enabled": "#enabled",
		"text_box_name": "custom_input",
		"text_edit_box_grid_collection_name": "custom_form",
		"max_length": 100,
		"text_type": "ExtendedASCII",
		"text_control": "display_text",
		"place_holder_control": "place_holder_control",
		"default_control": "default",
		"hover_control": "hover",
		"pressed_control": "pressed",
		"locked_control": "locked",
		"focus_enabled": true,
		"bindings": [
			{
				/* enabled state for this cell */
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_input_enabled",
				"binding_name_override": "#enabled"
			}
		],
		"controls": [
			{
				"text_area": {
					"type": "panel",
					// Above the payload-decoded state backgrounds (their bg images sit at
					// layer 1 inside LATER siblings — same effective layer + later tree
					// order painted them over the text once the input gained textures).
					"layer": 5,
					"size": [
						"100% - 6px",
						"100% - 4px"
					],
					"offset": ["8px", 0],
					"anchor_from": "left_middle",
					"anchor_to": "left_middle",
					"clips_children": true,
					"controls": [
						{
							"display_text": {
								"type": "label",
								"localize": false,
								"text": "#item_name",
								"color": [
									1,
									1,
									1,
									1
								],
								"locked_alpha": 0.5,
								"font_size": "normal",
								"text_alignment": "left",
								"anchor_from": "left_middle",
								"anchor_to": "left_middle",
								"size": [
									"default",
									"default"
								],
								"min_size": [
									"100%",
									0
								],
								"layer": 1,
								"property_bag": {
									"#property_field": "#item_name"
								},
								"bindings": [
									{
										/* the typed content for THIS cell */
										"binding_type": "collection",
										"binding_collection_name": "custom_form",
										"binding_name": "#custom_input_text",
										"binding_name_override": "#item_name"
									}
								]
							}
						},
						{
							"place_holder_visibility": {
								"type": "panel",
								"size": [
									"100%",
									"100%"
								],
								"controls": [
									{
										"place_holder_control": {
											"type": "label",
											"localize": false,
											"text": "#placeholder",
											"color": [
												0.7,
												0.7,
												0.7,
												1
											],
											"locked_alpha": 0.5,
											"font_size": "normal",
											"text_alignment": "left",
											"anchor_from": "left_middle",
											"anchor_to": "left_middle",
											"size": [
												"default",
												"default"
											],
											"min_size": [
												"100%",
												0
											],
											"layer": 1,
											"bindings": [
												{
													"binding_type": "collection",
													"binding_collection_name": "custom_form",
													"binding_name": "#custom_placeholder_text",
													"binding_name_override": "#placeholder"
												}
											]
										}
									}
								],
								"bindings": [
									{
										/* show placeholder only while the field is empty */
										"binding_type": "view",
										"source_control_name": "display_text",
										"source_property_name": "(#item_name = '')",
										"target_property_name": "#visible",
										"resolve_sibling_scope": true
									}
								]
							}
						}
					]
				}
			},
			{
				/* Payload-decoded background states: each panel's bg image reads its texture
				   from the button-identical field block (default [440], hover [1024],
				   pressed [1107], locked [1190]). */
				"default": {
					"type": "panel",
					"size": [
						"100%",
						"100%"
					],
					"controls": [
						{
							"bg": {
								"type": "image",
								"size": [
									"100%",
									"100%"
								],
								"layer": 1,
								"texture": "#texture",
								"bindings": [
									{
										/* texture field at absolute payload offset [440] */
										"binding_name": "#custom_text",
										"binding_type": "collection",
										"binding_collection_name": "custom_form"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.440s' * #custom_text)",
										"target_property_name": "#skip_bg"
									},
									{
										"binding_type": "view",
										"source_property_name": "(#custom_text - #skip_bg)",
										"target_property_name": "#rem_bg"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.83s' * #rem_bg)",
										"target_property_name": "#raw_bg"
									},
									{
										"binding_type": "view",
										"source_property_name": "(('%.82s' * #raw_bg) - ('%.2s' * #raw_bg) - ';')",
										"target_property_name": "#texture"
									}
								]
							}
						}
					]
				}
			},
			{
				"hover": {
					"type": "panel",
					"size": [
						"100%",
						"100%"
					],
					"controls": [
						{
							"bg": {
								"type": "image",
								"size": [
									"100%",
									"100%"
								],
								"layer": 1,
								"texture": "#texture",
								"bindings": [
									{
										/* texture field at absolute payload offset [1024] */
										"binding_name": "#custom_text",
										"binding_type": "collection",
										"binding_collection_name": "custom_form"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.1024s' * #custom_text)",
										"target_property_name": "#skip_hov"
									},
									{
										"binding_type": "view",
										"source_property_name": "(#custom_text - #skip_hov)",
										"target_property_name": "#rem_hov"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.83s' * #rem_hov)",
										"target_property_name": "#raw_hov"
									},
									{
										"binding_type": "view",
										"source_property_name": "(('%.82s' * #raw_hov) - ('%.2s' * #raw_hov) - ';')",
										"target_property_name": "#texture"
									}
								]
							}
						}
					]
				}
			},
			{
				"pressed": {
					"type": "panel",
					"size": [
						"100%",
						"100%"
					],
					"controls": [
						{
							"bg": {
								"type": "image",
								"size": [
									"100%",
									"100%"
								],
								"layer": 1,
								"texture": "#texture",
								"bindings": [
									{
										/* texture field at absolute payload offset [1107] */
										"binding_name": "#custom_text",
										"binding_type": "collection",
										"binding_collection_name": "custom_form"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.1107s' * #custom_text)",
										"target_property_name": "#skip_prs"
									},
									{
										"binding_type": "view",
										"source_property_name": "(#custom_text - #skip_prs)",
										"target_property_name": "#rem_prs"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.83s' * #rem_prs)",
										"target_property_name": "#raw_prs"
									},
									{
										"binding_type": "view",
										"source_property_name": "(('%.82s' * #raw_prs) - ('%.2s' * #raw_prs) - ';')",
										"target_property_name": "#texture"
									}
								]
							}
						}
					]
				}
			},
			{
				"locked": {
					"type": "panel",
					"size": [
						"100%",
						"100%"
					],
					"controls": [
						{
							"bg": {
								"type": "image",
								"size": [
									"100%",
									"100%"
								],
								"layer": 1,
								"texture": "#texture",
								"bindings": [
									{
										/* texture field at absolute payload offset [1190] */
										"binding_name": "#custom_text",
										"binding_type": "collection",
										"binding_collection_name": "custom_form"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.1190s' * #custom_text)",
										"target_property_name": "#skip_lock"
									},
									{
										"binding_type": "view",
										"source_property_name": "(#custom_text - #skip_lock)",
										"target_property_name": "#rem_lock"
									},
									{
										"binding_type": "view",
										"source_property_name": "('%.83s' * #rem_lock)",
										"target_property_name": "#raw_lock"
									},
									{
										"binding_type": "view",
										"source_property_name": "(('%.82s' * #raw_lock) - ('%.2s' * #raw_lock) - ';')",
										"target_property_name": "#texture"
									}
								]
							}
						}
					]
				}
			}
		]
	}
}