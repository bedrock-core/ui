{
	"namespace": "core_ui_form_components",
	"slider_router": {
		"type": "panel",
		// Components must be inside a panel with size [1,1] so size_binding values map 1:1 to pixels.
		"size": [
			1,
			1
		],
		"controls": [
			{
				"slider@core_ui_form_components.slider": {}
			}
		]
	},
	"slider": {
		"type": "panel",
		"size": [
			0,
			0
		],
		"layer": 50,
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"use_anchored_offset": true,
		"property_bag": {
			"#size_binding_x": 0.0,
			"#size_binding_y": 0.0,
			"#anchored_offset_value_x": 0.0,
			"#anchored_offset_value_y": 0.0
		},
		"visible": "#visible",
		"enabled": "#enabled",
		"$normalize": 1.0,
		"bindings": [
			{
				/* Per-cell collection context so #custom_text resolves to THIS row. */
				"binding_type": "collection_details",
				"binding_collection_name": "custom_form"
			},
			{
				"binding_name": "#custom_text",
				"binding_type": "collection",
				"binding_collection_name": "custom_form"
			},
			{
				/* --- strip protocol header (9 chars) --- */
				"binding_type": "view",
				"source_property_name": "('%.9s' * #custom_text)",
				"target_property_name": "#protocol_header"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#custom_text - #protocol_header)",
				"target_property_name": "#rem_after_header"
			},
			{
				/* --- type (string) - field 0 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_header)",
				"target_property_name": "#raw_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_header - #raw_type)",
				"target_property_name": "#rem_after_type"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_type) - ('%.2s' * #raw_type) - ';')",
				"target_property_name": "#type"
			},
			{
				/* --- width (int) - field 1 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_type)",
				"target_property_name": "#raw_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_type - #raw_width)",
				"target_property_name": "#rem_after_width"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_width) - ('%.2s' * #raw_width) - ';')",
				"target_property_name": "#size_binding_x"
			},
			{
				/* --- height (int) - field 2 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_width)",
				"target_property_name": "#raw_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_width - #raw_height)",
				"target_property_name": "#rem_after_height"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.82s' * #raw_height) - ('%.2s' * #raw_height) - ';')",
				"target_property_name": "#size_binding_y"
			},
			{
				/* --- x (int) - field 3 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_height)",
				"target_property_name": "#raw_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_height - #raw_x)",
				"target_property_name": "#rem_after_x"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_x) - ('%.2s' * #raw_x) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_x"
			},
			{
				/* --- y (float) - field 4 --- */
				"binding_type": "view",
				"source_property_name": "('%.83s' * #rem_after_x)",
				"target_property_name": "#raw_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_x - #raw_y)",
				"target_property_name": "#rem_after_y"
			},
			{
				"binding_type": "view",
				"source_property_name": "((('%.82s' * #raw_y) - ('%.2s' * #raw_y) - ';') * $normalize)",
				"target_property_name": "#anchored_offset_value_y"
			},
			{
				/* --- visible (boolean) - field 5 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_y)",
				"target_property_name": "#raw_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_y - #raw_visible)",
				"target_property_name": "#rem_after_visible"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_visible) - ('%.2s' * #raw_visible) - ';')",
				"target_property_name": "#pre_visible"
			},
			{
				/* --- enabled (boolean) - field 6 --- */
				"binding_type": "view",
				"source_property_name": "('%.8s' * #rem_after_visible)",
				"target_property_name": "#raw_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(#rem_after_visible - #raw_enabled)",
				"target_property_name": "#rem_after_enabled"
			},
			{
				"binding_type": "view",
				"source_property_name": "(('%.7s' * #raw_enabled) - ('%.2s' * #raw_enabled) - ';')",
				"target_property_name": "#enabled"
			},
			{
				/* Per-type visibility gate: only render the slider on slider cells. */
				"binding_type": "view",
				"source_property_name": "(#pre_visible and (#type = 'modal-slider'))",
				"target_property_name": "#visible"
			}
		],
		"controls": [
			{
				"slider@core_ui_form_components.slider_control": {}
			}
		]
	},
	// Native slider, flattened from vanilla common.slider (ui_common.json:880) + the
	// concrete sizing/composition vanilla uses for it (settings_common.json
	// option_slider_control:1290 — bar ["100%-8px",10] offset [1,0] inside a [*,16]
	// row; slider_box [10,16]). READ: #custom_slider_value (current) /
	// #custom_slider_steps (discrete positions; engine maps min/max/step to this) /
	// #custom_slider_enabled — all collection bindings on custom_form. WRITE-BACK: the
	// engine writes the chosen value to the current row via
	// slider_collection_name:"custom_form" (the slider analogue of the toggle hook).
	// Uses vanilla slider textures for now (visible/testable); Phase 2 makes it textureless.
	"slider_control": {
		"type": "slider",
		"size": [
			"100%",
			16
		],
		"anchor_from": "top_left",
		"anchor_to": "top_left",
		"layer": 2,
		"enabled": "#enabled",
		"slider_name": "custom_slider",
		"slider_track_button": "custom_slider",
		"slider_direction": "horizontal",
		"slider_collection_name": "custom_form",
		"slider_box_control": "slider_box",
		"default_control": "bar_default",
		"hover_control": "bar_hover",
		"slider_small_decrease_button": "slider.small_decrease",
		"slider_small_increase_button": "slider.small_increase",
		"slider_selected_button": "slider.selected",
		"slider_deselected_button": "slider.deselected",
		"always_listen_to_input": false,
		"always_handle_pointer": true,
		"focus_enabled": true,
		"default_focus_precedence": 0,
		"property_bag": {
			"#slider_steps": 1,
			"#slider_value": 0
		},
		"button_mappings": [
			{
				"from_button_id": "button.menu_select",
				"to_button_id": "custom_slider",
				"mapping_type": "pressed",
				"button_up_right_of_first_refusal": true
			},
			{
				"from_button_id": "button.menu_ok",
				"to_button_id": "slider.selected",
				"mapping_type": "focused"
			}
		],
		"bindings": [
			{
				/* number of discrete steps for THIS cell */
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_slider_steps",
				"binding_name_override": "#slider_steps"
			},
			{
				/* current value for THIS cell (read + write-back) */
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_slider_value",
				"binding_name_override": "#slider_value"
			},
			{
				"binding_type": "collection",
				"binding_collection_name": "custom_form",
				"binding_name": "#custom_slider_enabled",
				"binding_name_override": "#enabled"
			}
		],
		"controls": [
			{
				/* the draggable bar (track + clipped progress fill), vanilla size/offset */
				"bar_default": {
					"type": "image",
					"size": [ "100% - 8px", 10 ],
					"offset": [ 1, 0 ],
					"anchor_from": "left_middle",
					"anchor_to": "left_middle",
					"layer": 1,
					"texture": "textures/ui/slider_border",
					"controls": [
						{
							"sizing_panel": {
								"type": "panel",
								"size": [ "100% - 2px", "100% - 2px" ],
								"anchor_from": "center",
								"anchor_to": "center",
								"controls": [
									{
										"track": {
											"type": "image",
											"size": [ "100%", "100%" ],
											"layer": 1,
											"texture": "textures/ui/slider_background"
										}
									},
									{
										"progress": {
											"type": "image",
											"size": [ "100%", "100%" ],
											"layer": 3,
											"texture": "textures/ui/slider_progress",
											"clip_direction": "left",
											"clip_pixelperfect": false
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"bar_hover": {
					"type": "image",
					"size": [ "100% - 8px", 10 ],
					"offset": [ 1, 0 ],
					"anchor_from": "left_middle",
					"anchor_to": "left_middle",
					"layer": 1,
					"texture": "textures/ui/slider_border",
					"visible": false,
					"controls": [
						{
							"sizing_panel": {
								"type": "panel",
								"size": [ "100% - 2px", "100% - 2px" ],
								"anchor_from": "center",
								"anchor_to": "center",
								"controls": [
									{
										"track": {
											"type": "image",
											"size": [ "100%", "100%" ],
											"layer": 1,
											"texture": "textures/ui/slider_background_hover"
										}
									},
									{
										"progress": {
											"type": "image",
											"size": [ "100%", "100%" ],
											"layer": 3,
											"texture": "textures/ui/slider_progress_hover",
											"clip_direction": "left",
											"clip_pixelperfect": false
										}
									}
								]
							}
						}
					]
				}
			},
			{
				/* draggable handle, positioned by the engine along the bar */
				"slider_box": {
					"type": "slider_box",
					"size": [ 10, 16 ],
					"anchor_from": "center",
					"anchor_to": "center",
					"layer": 4,
					"default_control": "default",
					"hover_control": "hover",
					"locked_control": "locked",
					"indent_control": "indent",
					"controls": [
						{
							"default": {
								"type": "image",
								"layer": 2,
								"texture": "textures/ui/slider_button_default"
							}
						},
						{
							"hover": {
								"type": "image",
								"layer": 2,
								"texture": "textures/ui/slider_button_hover"
							}
						},
						{
							"locked": {
								"type": "image",
								"layer": 2,
								"texture": "textures/ui/slider_button_locked"
							}
						},
						{
							"indent": {
								"type": "image",
								"layer": 2,
								"texture": "textures/ui/slider_button_indent"
							}
						}
					]
				}
			}
		]
	}
}
