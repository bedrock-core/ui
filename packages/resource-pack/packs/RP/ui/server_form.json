{
	"namespace": "server_form",
	"third_party_server_screen": {
		"$screen_animations": [
			"@core_ui_animations.screen_enter_animation",
			"@core_ui_animations.screen_exit_animation"
		],
		// Enable the engine's gamepad virtual-cursor system so the analog stick
		// moves a cursor, #gamepad_cursor_visible fires, and scroll views under
		// the cursor receive pointer/scroll events.
		"gamepad_cursor": true
	},
	"long_form": {
		/* This hidden vanilla dialog is still constructed under the library's gate;
		   scrolling is off while its content fits, through the variable vanilla
		   threads into common.scrolling_panel for exactly this. Precautionary: the
		   bisected "Progress out of range" assertion turned out to be the compiled
		   slider's, not this panel's. */
		"$allow_scrolling_even_when_content_fits": false,
		"$protocol_header": "bcuiv0008",
		"modifications": [
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{
						"binding_name": "#title_text"
					},
					{
						"binding_type": "view",
						"source_property_name": "((#title_text - $protocol_header) = #title_text)",
						"target_property_name": "#visible"
					}
				]
			}
		]
	},
	"custom_form": {
		/* This hidden vanilla dialog is still constructed under the library's gate;
		   scrolling is off while its content fits, through the variable vanilla
		   threads into common.scrolling_panel for exactly this. Precautionary: the
		   bisected "Progress out of range" assertion turned out to be the compiled
		   slider's, not this panel's. */
		"$allow_scrolling_even_when_content_fits": false,
		"$protocol_header": "bcuiv0008",
		"modifications": [
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{
						"binding_name": "#title_text"
					},
					{
						"binding_type": "view",
						"source_property_name": "((#title_text - $protocol_header) = #title_text)",
						"target_property_name": "#visible"
					}
				]
			}
		]
	},
	/* Vanilla's own button per entry stays constructed under every title, and
	   its icon image loads whatever the entry's icon path says. A compiled form
	   carries each entry's VALUE there (the text is the payload decoy every
	   decoder ignores), and the engine hunting the packs for a texture named
	   "§fEconomy" seventy-five times is what a slow list is made of. So the
	   icon is read only while the entry's text is not the decoy. */
	"dynamic_button": {
		"modifications": [
			{
				"array_name": "controls",
				"operation": "replace",
				"control_name": "panel_name",
				"value": {
					"panel_name": {
						"type": "panel",
						"size": [
							34,
							"100%c"
						],
						"bindings": [
							{
								"binding_type": "view",
								"source_control_name": "image",
								"resolve_sibling_scope": true,
								"source_property_name": "(not (#texture = ''))",
								"target_property_name": "#visible"
							}
						],
						"controls": [
							{
								"image": {
									"type": "image",
									"layer": 2,
									"size": [
										32,
										32
									],
									"offset": [
										0,
										0
									],
									"bindings": [
										{
											"binding_name": "#form_button_text",
											"binding_name_override": "#entry_text",
											"binding_type": "collection",
											"binding_collection_name": "form_buttons"
										},
										{
											"binding_name": "#form_button_texture",
											"binding_name_override": "#icon",
											"binding_type": "collection",
											"binding_collection_name": "form_buttons"
										},
										{
											"binding_name": "#form_button_texture_file_system",
											"binding_name_override": "#texture_file_system",
											"binding_type": "collection",
											"binding_collection_name": "form_buttons"
										},
										{
											"binding_type": "view",
											"source_property_name": "(((not (#entry_text = 'bcuiv0008s:panel;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;0b:false1')) and #icon) or '')",
											"target_property_name": "#texture"
										},
										{
											"binding_type": "view",
											"source_property_name": "(not ((#texture = '') or (#texture = 'loading')))",
											"target_property_name": "#visible"
										}
									]
								}
							},
							{
								"progress@progress.progress_loading_bars": {
									"size": [
										30,
										4
									],
									"offset": [
										-2,
										16
									],
									"bindings": [
										{
											"binding_type": "view",
											"source_control_name": "image",
											"resolve_sibling_scope": true,
											"source_property_name": "(#texture = 'loading')",
											"target_property_name": "#visible"
										}
									]
								}
							}
						]
					}
				}
			}
		]
	},
	"main_screen_content": {
		"$protocol_header": "bcuiv0008",
		"size": [
			"0px",
			"0px"
		],
		"property_bag": {
			"#size_binding_x": "0px",
			"#size_binding_y": "0px"
		},
		"modifications": [
			{
				/* Full-screen <Background> backdrop — BEFORE the factory so it sits behind
				   both containers; decodes its texture from the title's fixed 2573 slot and
				   self-hides when absent (see core_ui_common.form_background). */
				"array_name": "controls",
				"operation": "insert_front",
				"value": [
					{
						"form_background@core_ui_common.form_background": {}
					}
				]
			},
			{
				"array_name": "controls",
				"operation": "insert_back",
				"value": [
					{
						"core_ui_server_form_factory": {
							"type": "panel",
							"factory": {
								"name": "server_form_factory",
								"control_ids": {
									"long_form": "@core_ui_common.action_container",
									"custom_form": "@core_ui_common.modal_container"
								}
							}
						}
					},
					{
						"gamepad_cursor@core_ui_common.gamepad_cursor_button": {}
					}
				]
			},
			{
				"array_name": "bindings",
				"operation": "insert_back",
				"value": [
					{
						"binding_name": "#title_text"
					},
					{
						"binding_type": "view",
						"source_property_name": "((((#title_text - $protocol_header) = #title_text) and '0px') or '100%')",
						"target_property_name": "#size_binding_x"
					},
					{
						"binding_type": "view",
						"source_property_name": "((((#title_text - $protocol_header) = #title_text) and '0px') or '100%')",
						"target_property_name": "#size_binding_y"
					}
				]
			}
		]
	}
}