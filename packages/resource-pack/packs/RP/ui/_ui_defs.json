{
	"ui_defs": [
		// Vanilla's two hooks: the server form every compiled form screen is shown
		// through, and the chest every compiled container screen is opened from.
		// Each addon's ui-compiler build ships its own copy of these paths, and the
		// engine stacks every pack's.
		"ui/server_form.json",
		"ui/chest_screen.json",

		// Shapes: controls that are the same wherever they are drawn, so no host
		// owns them. A scrolling region is one — it reads nothing and binds
		// nothing, it just clips and scrolls.
		"ui/core-ui/shapes/scroll.json",

		// S7, measuring which of an entry's two strings can carry a value.
		// Gated on its own title marker; no shipped screen reaches it.
		"ui/core-ui/spikes/form_text.json",

		// The FORM host: the two containers the screen factory routes into, the
		// mount a compiled screen hangs from, and the pieces a modal's own rows
		// are drawn with.
		"ui/core-ui/hosts/form/animations.json",
		"ui/core-ui/hosts/form/action_container.json",
		"ui/core-ui/hosts/form/modal_container.json",
		"ui/core-ui/hosts/form/mount.json",
		"ui/core-ui/hosts/form/cursor.json",
		// The faces a field wears, and the label a row draws its text with.
		"ui/core-ui/hosts/form/state.json",
		"ui/core-ui/hosts/form/text.json",
		// One per native field the engine makes: the pack says what it looks like.
		"ui/core-ui/hosts/form/components/toggle.json",
		"ui/core-ui/hosts/form/components/input.json",
		"ui/core-ui/hosts/form/components/slider.json",
		"ui/core-ui/hosts/form/components/dropdown.json",
		"ui/core-ui/hosts/form/components/inline_select.json",
		// The option faces the dropdown popup and the inline select share.
		"ui/core-ui/hosts/form/components/form_shared.json",

		// The CHEST host: the cells, the text hosts, the transport-hiding item
		// renderer, the chrome, and the root every addon's router adds its own
		// screens to. The screens and the routers themselves are emitted by the
		// ui-compiler filter into each addon's pack, which registers them there.
		"ui/core-ui/hosts/chest/cell.json",
		"ui/core-ui/hosts/chest/text.json",
		"ui/core-ui/hosts/chest/gated_item.json",
		"ui/core-ui/hosts/chest/chrome.json",
		"ui/core-ui/hosts/chest/router.json"
	]
}
