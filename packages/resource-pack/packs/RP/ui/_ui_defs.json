{
	"ui_defs": [
		"ui/server_form.json",
		// Vanilla's chest, hooked for compiled container screens: the screen's
		// content pointed at the chest root, and a gate on its title and grid;
		// each addon's ui-compile build inserts its root into its own copy of
		// this path.
		"ui/chest_screen.json",
		// Animations
		"ui/core-ui/animations/screen_events.json",
		// Shared bases every component extends (all namespace core_ui_common):
		//   control    — the generic control-block decode (position/size/visible/region)
		//   state.json — state_face / modal_state_face (self-decoding bg faces)
		"ui/core-ui/common/control.json",
		"ui/core-ui/common/state.json",
		"ui/core-ui/common/action_container.json",
		"ui/core-ui/common/modal_container.json",
		"ui/core-ui/common/form_background.json",
		"ui/core-ui/common/label_router.json",
		"ui/core-ui/common/button_router.json",
		"ui/core-ui/common/header_router.json",
		"ui/core-ui/common/dropdown_router.json",
		"ui/core-ui/common/cursor.json",
		// -----------------------------------------------
		// After the initial reserved bytes for the common, rest of bytes 
		// after 1024 for its own use and 
		// available in #serialized_data binding
		// Scrolls
		"ui/core-ui/screens/scroll.json",
		"ui/core-ui/screens/scroll_pool.json",
		// Components (panel.json is gone: panel cells render through the merged
		// label_cell's cell_bg leaf in text.json)
		"ui/core-ui/components/button.json",
		"ui/core-ui/components/text.json",
		"ui/core-ui/components/image.json",
		// Form components
		"ui/core-ui/form_components/toggle.json",
		"ui/core-ui/form_components/input.json",
		"ui/core-ui/form_components/slider.json",
		// Shared bases + option faces used by the dropdown + inline-select primitives.
		"ui/core-ui/form_components/form_shared.json",
		// Router for native-dropdown cells (fans #type → dropdown popup | inline radio/toggle-button).
		"ui/core-ui/form_components/dropdown.json",
		"ui/core-ui/form_components/inline_select.json",
		"ui/core-ui/form_components/label.json",
		// Container screens: the cells, text hosts, scroll, transport-hiding
		// renderer and chrome every compiled screen references (namespace
		// core_ui_container), and the chest root every addon's router adds its
		// screens to (namespace core_ui_router). The screens themselves and each
		// addon's router are emitted by the ui-compile filter into the addon's
		// own pack, which registers them in its own _ui_defs.json at build time.
		"ui/core-ui/container/cell.json",
		"ui/core-ui/container/text.json",
		"ui/core-ui/container/gated_item.json",
		"ui/core-ui/container/scroll.json",
		"ui/core-ui/container/chrome.json",
		"ui/core-ui/container/router.json",
		// Compiled form screens: the mount every addon's screens hang from, and
		// the gate that decides between a compiled screen and the interpreter.
		// Each addon ships a copy of this same path to insert its own.
		"ui/core-ui/form/mount.json"
	]
}