		"ui/core-ui/screens/scroll.json",
		"ui/core-ui/screens/scroll_pool.json",
		// Components 
		"ui/core-ui/components/button.json",
		"ui/core-ui/components/panel.json",
		"ui/core-ui/components/text.json",
		"ui/core-ui/components/image.json",
		"ui/core-ui/components/item_renderer.json",
		// Form components
		"ui/core-ui/form_components/toggle.json",
		"ui/core-ui/form_components/input.json",
		"ui/core-ui/form_components/slider.json",
		// Shared bases + option faces used by the dropdown + inline-select primitives.
		"ui/core-ui/form_components/form_shared.json",
		// Router for native-dropdown cells (fans #type → dropdown popup | inline radio/toggle-button).
		"ui/core-ui/form_components/dropdown_router.json",
