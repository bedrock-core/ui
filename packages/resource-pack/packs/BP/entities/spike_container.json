{
	"format_version": "1.21.0",
	"minecraft:entity": {
		"description": {
			"identifier": "core:spike_container",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"components": {
			// SPIKE — `container` is the only container_type that routes to
			// chest_screen.json. 54 was measured: the engine picks small_chest_screen,
			// whose grid draws 27, while #collection_total_items reports the full 54.
			//
			// Now testing the CEILING, because <SlotGrid rows cols> needs to know it.
			// 200 is the first probe. Watch for: does the container open at all, does
			// the screen still report the full count, and does poll cost scale with
			// size (the Q5 line already measures it). If 200 works, try 500.
			"minecraft:inventory": {
				"container_type": "container",
				"inventory_size": 200,
				"private": false,
				"restrict_to_owner": false,
				"can_be_siphoned_from": false
			},
			"minecraft:physics": {
				"has_gravity": false,
				"has_collision": false
			},
			"minecraft:pushable": {
				"is_pushable": false,
				"is_pushable_by_piston": false
			},
			"minecraft:knockback_resistance": {
				"value": 1
			},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "all",
						"deals_damage": "no"
					}
				]
			},
			"minecraft:health": {
				"value": 1024,
				"max": 1024
			},
			"minecraft:collision_box": {
				"width": 0.8,
				"height": 1.9
			},
			"minecraft:fire_immune": {},
			"minecraft:persistent": {},
			"minecraft:type_family": {
				"family": [
					"bcui_spike",
					"inanimate"
				]
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false,
				"always_show": true
			},
			"minecraft:conditional_bandwidth_optimization": {}
		}
	}
}
