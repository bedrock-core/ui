{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"jsx": "react-jsx",
		"jsxImportSource": "@bedrock-core/ui",
		"paths": {
			"@bedrock-core/generated/i18n": [
				"./packs/data/i18n/i18n.generated.json"
			],
			"@bedrock-core/generated/guides": [
				"./packs/data/guides/guides.generated.json"
			],
			"@bedrock-core/generated/ui": [
				"./packs/data/ui/ui.generated.ts"
			]
		}
	},
	"include": [
		"packs/BP/scripts/**/*",
		"packs/data/**/*"
	],
	"exclude": [
		"node_modules",
		"build"
	]
}
