{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"rootDir": "../..",
		"outDir": "packs/BP/scripts/",
		"paths": {
			"@bedrock-core/ui": [
				"../../packages/ui-runtime/src/index.ts"
			],
			"@bedrock-core/ui/*": [
				"../../packages/ui-runtime/src/*"
			],
			"@bedrock-core/ui-runtime": [
				"../../packages/ui-runtime/src/index.ts"
			],
			"@bedrock-core/ui-runtime/*": [
				"../../packages/ui-runtime/src/*"
			],
			"@bedrock-core/ui/jsx-runtime": [
				"../../packages/ui-runtime/src/jsx/jsx-runtime.ts"
			],
			"@bedrock-core/ui/jsx-dev-runtime": [
				"../../packages/ui-runtime/src/jsx/jsx-dev-runtime.ts"
			],
			"@bedrock-core/i18n": [
				"../../packages/i18n/src/index.ts"
			],
			"@bedrock-core/i18n/*": [
				"../../packages/i18n/src/*"
			],
			"@bedrock-core/generated/i18n": [
				"./packs/data/i18n/i18n.generated.json"
			],
			"@bedrock-core/generated/guides": [
				"./packs/data/guides/guides.generated.json"
			]
		}
	},
	"include": [
		"packs/BP/scripts/**/*",
		"packs/data/**/*"
	]
}
